      "parameters": {
        "jsCode": "const corpo = $input.first().json.body || {};\nconst PAPEIS = ['Dono', 'Usuario'];\nconst vazio = (v) => v === undefined || v === null || v === '';\n\nconst usuarioId = String(corpo.usuarioId || '');\nconst papel = vazio(corpo.papel) ? null : String(corpo.papel);\nconst ativoTexto = vazio(corpo.ativo) ? null : String(corpo.ativo);\n\nlet erro = '';\nif (!/^rec[A-Za-z0-9]{14}$/.test(usuarioId)) erro = 'Usuário inválido.';\nelse if (papel !== null && !PAPEIS.includes(papel)) erro = 'Escolha um nível de acesso válido.';\nelse if (ativoTexto !== null && ativoTexto !== 'true' && ativoTexto !== 'false') erro = 'Valor inválido.';\nelse if (papel === null && ativoTexto === null) erro = 'Nenhuma alteração para salvar.';\n\nreturn [{\n  json: {\n    tokenAcesso: String(corpo.tokenAcesso || ''),\n    senhaConfirmacao: String(corpo.senhaConfirmacao || ''),\n    usuarioId,\n    papel,\n    ativo: ativoTexto === null ? null : ativoTexto === 'true',\n    erro,\n  },\n}];\n"
      },
