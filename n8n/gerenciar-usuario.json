        "jsCode": "const BASE = 'app6PyYmtFduIMp7B';\nconst TABELA = 'tblucYjrD3SKf1azh';\nconst LIMITE = 5;\n\nconst aut = $('Confere autorizacao').first().json;\nconst certa = $input.first().json.valido === true;\nconst urlChamador = 'https://api.airtable.com/v0/' + BASE + '/' + TABELA + '/' + aut.chamadorId;\n\nif (certa) {\n  return [{\n    json: {\n      senhaCerta: true,\n      principal: aut.acaoPrincipal,\n      zerar: { metodo: 'PATCH', url: urlChamador, corpo: { fields: { Confirmacao_Falhas: 0 } } },\n    },\n  }];\n}\n\nconst falhas = aut.falhas + 1;\nconst bloqueia = falhas >= LIMITE;\nconst restam = LIMITE - falhas;\nconst fields = bloqueia\n  ? { Confirmacao_Falhas: 0, Confirmacao_Bloqueada_Ate: new Date(Date.now() + 15 * 60 * 1000).toISOString() }\n  : { Confirmacao_Falhas: falhas };\n\nreturn [{\n  json: {\n    senhaCerta: false,\n    metodo: 'PATCH',\n    url: urlChamador,\n    corpo: { fields },\n    mensagem: bloqueia\n      ? 'Senha incorreta. Por segurança, essa confirmação ficou bloqueada por 15 minutos.'\n      : 'Senha incorreta. ' + (restam === 1 ? 'Resta 1 tentativa.' : 'Restam ' + restam + ' tentativas.'),\n  },\n}];\n"
