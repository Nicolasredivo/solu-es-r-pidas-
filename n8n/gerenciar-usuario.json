      "parameters": {
        "jsCode": "const BASE = 'app6PyYmtFduIMp7B';\nconst TABELA = 'tblucYjrD3SKf1azh';\n\nconst token = $('Confere token').first().json;\nconst entrada = $('Le entrada').first().json;\nconst registros = $input.all().map((i) => i.json).filter((r) => r && r.id);\n\nconst negar = (mensagem, extra) => [{ json: Object.assign({ pode: false, mensagem }, extra || {}) }];\n\nif (!token.valido) return negar('Sua sessão expirou. Entre de novo para continuar.', { sessao: true });\n\n// Papel e situação lidos agora do Airtable, não do token: um token emitido\n// antes de a pessoa perder o acesso total ainda vale por até 30 minutos.\nconst chamador = registros.find((r) => r.id === token.usuarioId);\nconst c = (chamador && chamador.fields) || {};\nif (!chamador || c.Ativo !== true || c.Papel !== 'Dono' || !c.Senha_Hash) {\n  return negar('Só quem tem acesso total pode alterar contas.');\n}\n\nconst bloqueio = c.Confirmacao_Bloqueada_Ate ? new Date(c.Confirmacao_Bloqueada_Ate).getTime() : 0;\nif (bloqueio > Date.now()) {\n  const minutos = Math.max(1, Math.ceil((bloqueio - Date.now()) / 60000));\n  return negar('Muitas senhas erradas seguidas. Tente de novo em ' + minutos + ' min.');\n}\n\nif (entrada.erro) return negar(entrada.erro);\n\nconst alvo = registros.find((r) => r.id === entrada.usuarioId);\nif (!alvo) return negar('Usuário não encontrado.');\nconst a = alvo.fields || {};\n\nconst papelAtual = a.Papel || 'Usuario';\nconst ativoAtual = a.Ativo === true;\nconst papelNovo = entrada.papel !== null ? entrada.papel : papelAtual;\nconst ativoNovo = entrada.ativo !== null ? entrada.ativo : ativoAtual;\n\nif (papelNovo === papelAtual && ativoNovo === ativoAtual) {\n  return negar('Nenhuma alteração para salvar.');\n}\n\n// Nunca deixar o sistema sem ninguém com acesso total ativo: sem isso, dava\n// pra se trancar pra fora de vez (a primeira conta automática só vale com a\n// tabela sem nenhuma conta ativada).\nconst donoAtivo = (f) => f.Papel === 'Dono' && f.Ativo === true && Boolean(f.Senha_Hash);\nconst sobra = registros.some((r) => {\n  const f = r.id === alvo.id ? Object.assign({}, r.fields, { Papel: papelNovo, Ativo: ativoNovo }) : (r.fields || {});\n  return donoAtivo(f);\n});\nif (!sobra) {\n  return negar('O sistema precisa de pelo menos uma pessoa com acesso total ativa. Dê acesso total a outra pessoa antes.');\n}\n\nconst carimbo = new Date()\n  .toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })\n  .replace(',', '');\nconst quem = c.Nome || c.Email;\nconst nivel = (p) => (p === 'Dono' ? 'acesso total' : 'acesso padrão');\n\nconst linhas = [];\nconst campos = {};\nif (papelNovo !== papelAtual) {\n  campos.Papel = papelNovo;\n  linhas.push(carimbo + ' — Nível alterado de ' + nivel(papelAtual) + ' para ' + nivel(papelNovo) + ' por ' + quem);\n}\nif (ativoNovo !== ativoAtual) {\n  campos.Ativo = ativoNovo;\n  linhas.push(carimbo + ' — Conta ' + (ativoNovo ? 'reativada' : 'desativada') + ' por ' + quem);\n}\ncampos.Historico = (a.Historico ? a.Historico + '\\n' : '') + linhas.join('\\n');\n\nreturn [{\n  json: {\n    pode: true,\n    chamadorId: chamador.id,\n    chamadorHash: c.Senha_Hash,\n    falhas: Number(c.Confirmacao_Falhas) || 0,\n    alvoId: alvo.id,\n    acaoPrincipal: {\n      metodo: 'PATCH',\n      url: 'https://api.airtable.com/v0/' + BASE + '/' + TABELA + '/' + alvo.id,\n      corpo: { fields: campos },\n    },\n    resumo: { nome: a.Nome || a.Email || 'essa pessoa' },\n  },\n}];\n"
      },
