    {
      "parameters": {
        "jsCode": "// Resposta quando já existe, ou quando é CPF (não consultamos a Receita).\nreturn [{\n  json: {\n    ok: true,\n    jaExiste: Boolean($json.jaExiste),\n    entidade: $json.jaExiste ? { nome: $json.nome } : null,\n    receita: null,\n  },\n}];"
      },
