    {
      "parameters": {
        "jsCode": "// Junta o que veio do Airtable com o documento pedido pelo app.\nconst pedido = $('Recebe pedido do app').first().json.body;\nconst documento = String(pedido.documento || '').replace(/\\D/g, '');\n\n// O nó do Airtable devolve um item vazio quando não encontra nada.\nconst achados = items.filter((item) => item.json && item.json.id);\nconst encontrado = achados.length > 0 ? achados[0].json : null;\n\nreturn [{\n  json: {\n    documento,\n    jaExiste: Boolean(encontrado),\n    nome: encontrado ? (encontrado.fields?.Razao_Social_Nome || '') : '',\n    buscarNaReceita: !encontrado && documento.length === 14,\n  },\n}];"
      },
