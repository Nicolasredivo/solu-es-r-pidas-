    {
      "parameters": {
        "jsCode": "// Monta a resposta final com os dados da Receita, quando vieram.\nconst receita = $json || {};\n\nconst telefone = receita.ddd_telefone_1 || receita.ddd_telefone_2 || '';\n\nreturn [{\n  json: {\n    ok: true,\n    jaExiste: false,\n    receita: receita.razao_social\n      ? {\n          razaoSocial: receita.razao_social || '',\n          nomeFantasia: receita.nome_fantasia || '',\n          email: receita.email || '',\n          telefone,\n        }\n      : null,\n  },\n}];"
      },
      "id": "c0000000-0000-4000-8000-000000000008",
