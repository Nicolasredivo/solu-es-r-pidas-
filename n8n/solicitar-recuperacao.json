        "jsCode": "const g = $input.first().json;\nconst baseId = 'app6PyYmtFduIMp7B';\nconst tableId = 'tblucYjrD3SKf1azh';\n\nreturn [{\n  json: {\n    metodo: 'PATCH',\n    url: 'https://api.airtable.com/v0/' + baseId + '/' + tableId + '/' + g.usuarioId,\n    corpo: {\n      fields: {\n        Codigo_Recuperacao_Hash: g.codigoHash,\n        Codigo_Expira_Em: g.expiraEm,\n        Codigo_Tentativas: 0\n      }\n    },\n    nome: g.nome,\n    email: g.email,\n    codigo: g.codigo\n  }\n}];\n"
      },
