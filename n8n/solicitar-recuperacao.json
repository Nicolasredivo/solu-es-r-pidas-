      "parameters": {
        "jsCode": "const corpo = $input.first().json.body || {};\n\nconst email = String(corpo.email || '').trim().toLowerCase();\nconst codigo = String(corpo.codigo || '').trim();\nconst novaSenha = String(corpo.novaSenha || '');\n\nconst emailEscapado = email.replace(/'/g, \"\\\\'\");\n\nreturn [{\n  json: {\n    email,\n    codigo,\n    novaSenha,\n    formula: \"LOWER({Email}) = '\" + emailEscapado + \"'\"\n  }\n}];\n"
      },
