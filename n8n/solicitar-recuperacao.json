    {
      "parameters": {
        "jsCode": "const registros = $input.all();\nconst registro = registros[0] && registros[0].json;\nconst campos = (registro && registro.fields) || {};\n\n// Recuperação é só pra conta ativa. Convite pendente (sem senha) ativa pela\n// tela \"Criar conta\" -- os dois usam os mesmos campos de código, então é\n// essa trava que impede um fluxo de mexer na conta do outro.\nif (!registro || !registro.id || !campos.Senha_Hash || campos.Ativo !== true) {\n  return [{ json: { encontrado: false } }];\n}\n\nreturn [{ json: { encontrado: true, registro } }];\n"
      },
