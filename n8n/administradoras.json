    {
      "id": "903dddb4-fad5-4ae9-93f1-0a4aa4a38ef1",
      "name": "Le entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "jsCode": "// Tudo chega como texto (o app manda formulário simples); a lista de e-mails vem em JSON.\nconst corpo = $('Recebe pedido do app').first().json.body || {};\nconst texto = (v) => String(v ?? '').trim();\nconst ACOES = ['listar', 'salvar', 'editar'];\nconst acao = ACOES.includes(texto(corpo.acao)) ? texto(corpo.acao) : '';\nconst nome = texto(corpo.nome).replace(/\\s+/g, ' ').slice(0, 120);\n// editar: a administradora (id) que ganha a lista nova de e-mails.\nconst id = /^rec[A-Za-z0-9]{14}$/.test(texto(corpo.id)) ? texto(corpo.id) : '';\nlet brutos = [];\nlet listaOk = true;\ntry { const l = JSON.parse(texto(corpo.emails) || '[]'); if (Array.isArray(l)) brutos = l.map(texto).filter(Boolean); else listaOk = false; }\ncatch (e) { listaOk = false; }\n// E-mail repetido com outra caixa (Fulano@ e fulano@) é o mesmo e-mail.\nconst emails = [];\nfor (const e of brutos) if (!emails.some((x) => x.toLowerCase() === e.toLowerCase())) emails.push(e);\nlet erro = '';\nif (!acao) erro = 'Ação inválida.';\nelse if (acao === 'salvar' && !nome) erro = 'Escreva o nome da administradora.';\nelse if (acao === 'editar' && !id) erro = 'Administradora inválida.';\nelse if ((acao === 'salvar' || acao === 'editar') && (!listaOk || emails.length > 20 || emails.some((e) => e.length > 254))) erro = 'E-mail inválido.';\nreturn [{ json: { acao, id, nome, emails, erro } }];"
      }
    },
