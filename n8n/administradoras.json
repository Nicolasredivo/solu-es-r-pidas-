      "parameters": {
        "jsCode": "const reg = (($input.first().json.records) || [])[0];\nif (!reg || !reg.id) return [{ json: { ok: false, mensagem: 'Não foi possível salvar agora. Tente de novo em instantes.' } }];\nconst QUEBRA = String.fromCharCode(10);\nconst f = reg.fields || {};\nreturn [{ json: { ok: true, administradora: { id: reg.id, nome: f.Nome || '',\n  emails: String(f.Emails || '').split(QUEBRA).map((v) => v.trim()).filter(Boolean), clientes: [] } } }];"
