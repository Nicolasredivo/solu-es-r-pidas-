    {
      "id": "e5f1243c-ad4b-4fb0-8f47-32ccac824724",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -200
      ],
      "parameters": {
        "jsCode": "const e = $('Le entrada').first().json;\nconst administradorasBrutas = $('Busca administradoras').all().map((i) => i.json);\nconst clientesBrutos = $('Busca clientes').all().map((i) => i.json);\nconst recusa = (mensagem) => [{ json: { gravar: false, resposta: { ok: false, mensagem } } }];\n\n// Banco fora do ar não pode parecer \"nenhuma administradora\".\nif (administradorasBrutas.some((j) => j && j.error) || clientesBrutos.some((j) => j && j.error)) {\n  return recusa('Não foi possível falar com o banco agora. Tente de novo em instantes.');\n}\n\n// \"Administradora Exemplo\" e \"ADMINISTRADORA EXEMPLO.\" são a mesma: igual ao normalizarTexto do app.\nconst chave = (t) => String(t || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();\nconst QUEBRA = String.fromCharCode(10);\nconst porLinha = (t) => String(t || '').split(QUEBRA).map((v) => v.trim()).filter(Boolean);\nconst administradoras = administradorasBrutas.filter((j) => j && j.id)\n  .map((j) => ({ id: j.id, nome: (j.fields && j.fields.Nome) || '', emails: porLinha(j.fields && j.fields.Emails) }));\n\nif (e.acao === 'listar') {\n  // Os clientes dela: os que têm o mesmo nome no campo Administradora.\n  const clientes = clientesBrutos.filter((j) => j && j.id).map((j) => {\n    const f = j.fields || {};\n    return { id: j.id, nome: f.Nome_Fantasia_Identificador || f.Razao_Social_Nome || '', chave: chave(f.Administradora) };\n  });\n  const lista = administradoras.map((a) => ({\n    ...a,\n    clientes: clientes.filter((c) => c.chave && c.chave === chave(a.nome))\n      .map((c) => ({ id: c.id, nome: c.nome }))\n      .sort((x, y) => (x.nome || '~').localeCompare(y.nome || '~', 'pt-BR')),\n  })).sort((x, y) => x.nome.localeCompare(y.nome, 'pt-BR', { sensitivity: 'base' }));\n  return [{ json: { gravar: false, resposta: { ok: true, administradoras: lista } } }];\n}\n\n// editar: troca só os e-mails (o nome é o que liga os clientes a ela).\nif (e.acao === 'editar') {\n  const atual = administradoras.find((a) => a.id === e.id);\n  if (!atual) return recusa('Essa administradora não existe mais. Toque em Atualizar.');\n  return [{ json: { gravar: true, acao: 'editar', metodo: 'PATCH', url: 'http://127.0.0.1:5690/v0/app6PyYmtFduIMp7B/tblAdministrad001', corpo: { records: [{ id: atual.id, fields: { Emails: e.emails.join(QUEBRA) } }] } } }];\n}\n\n// salvar: nome e e-mails, e nunca duas com o mesmo nome.\nif (!chave(e.nome)) return recusa('Escreva o nome da administradora.');\nconst igual = administradoras.find((a) => chave(a.nome) === chave(e.nome));\nif (igual) return [{ json: { gravar: false, resposta: { ok: false, jaExiste: true, mensagem: 'Já existe a administradora \"' + igual.nome + '\".', administradora: igual } } }];\nreturn [{ json: { gravar: true, acao: 'salvar', metodo: 'POST', url: 'http://127.0.0.1:5690/v0/app6PyYmtFduIMp7B/tblAdministrad001', corpo: { records: [{ fields: { Nome: e.nome, Emails: e.emails.join(QUEBRA) } }] } } }];"
      }
    },
