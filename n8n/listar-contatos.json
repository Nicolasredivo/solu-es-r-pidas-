    {
      "parameters": {
        "jsCode": "// WhatsApps e Emails guardam um valor por linha dentro do mesmo campo.\nconst QUEBRA_DE_LINHA = String.fromCharCode(10);\nconst porLinha = (texto) => String(texto || \"\").split(QUEBRA_DE_LINHA).map((v) => v.trim()).filter(Boolean);\nconst achados = $input.all().filter((i) => i.json && i.json.id && !i.json.error);\n\nconst contatos = achados.map((i) => {\n  const c = i.json.fields || {};\n  return {\n    id: i.json.id,\n    nome: c.Nome_Contato || \"\",\n    cargo: c.Cargo_Funcao || \"\",\n    whatsapps: porLinha(c.WhatsApps),\n    emails: porLinha(c.Emails),\n    observacoes: c.Observacoes || \"\",\n    status: c.Status || \"\",\n  };\n});\n\nreturn [{ json: { ok: true, contatos } }];"
      },
