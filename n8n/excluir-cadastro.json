    {
      "parameters": {
        "jsCode": "// O app ja abriu o cadastro antes de mandar apagar, entao ele conhece os\n// enderecos e contatos: nao precisamos procurar de novo aqui.\nconst b = $json.body || {};\nconst limpa = (v) => String(v || '').split(',').map((x) => x.trim())\n  .filter((x) => /^rec[A-Za-z0-9]{14}$/.test(x));\n\nconst entidadeId = limpa(b.id)[0];\nif (!entidadeId) throw new Error('Pedido sem o codigo do cadastro.');\n\nconst BASE = 'https://api.airtable.com/v0/app6PyYmtFduIMp7B/';\nconst TABELAS = { locais: 'tblffVczCf1VeNxs7', contatos: 'tblXXOEOCwQnC2qFX', entidades: 'tbl5Joji6gAir3mNh' };\n\n// O Airtable apaga no maximo 10 por chamada.\nconst emLotes = (ids) => {\n  const lotes = [];\n  for (let i = 0; i < ids.length; i += 10) lotes.push(ids.slice(i, i + 10));\n  return lotes;\n};\nconst monta = (tabela, ids) => emLotes(ids).map((lote) => ({\n  json: { url: BASE + tabela + '?' + lote.map((id) => 'records[]=' + id).join('&') },\n}));\n\n// Os ligados saem primeiro; o cadastro por ultimo, para nao sobrar\n// endereco apontando para um cliente que ja deixou de existir.\nreturn [\n  ...monta(TABELAS.locais, limpa(b.locaisIds)),\n  ...monta(TABELAS.contatos, limpa(b.contatosIds)),\n  ...monta(TABELAS.entidades, [entidadeId]),\n];"
      },
      "id": "e0000000-0000-4000-8000-000000000034",
      "name": "Monta a lista do que apagar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -60
      ]
    },
