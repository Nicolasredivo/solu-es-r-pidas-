    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst BASE = 'app6PyYmtFduIMp7B';\nconst TABELA = 'tblucYjrD3SKf1azh';\n\nconst entrada = $('Le entrada').first().json;\nif (!entrada.emailValido) {\n  return [{ json: { acao: 'invalido' } }];\n}\n\n// A busca volta com um item vazio ({}) quando a tabela não tem nada --\n// só conta como registro o que tiver id de verdade.\nconst registros = $input.all().map((i) => i.json).filter((r) => r && r.id);\nconst temSenha = (r) => Boolean(r.fields && r.fields.Senha_Hash);\nconst emailDe = (r) => String((r.fields && r.fields.Email) || '').trim().toLowerCase();\n\n// Primeira conta: enquanto ninguém ativou conta nenhuma, quem chegar vira Dono.\nconst primeiraConta = !registros.some(temSenha);\nlet alvo = registros.find((r) => emailDe(r) === entrada.email) || null;\n\nif (alvo && temSenha(alvo)) {\n  return [{ json: { acao: 'ja_ativada' } }];\n}\nif (!alvo && !primeiraConta) {\n  return [{ json: { acao: 'sem_convite' } }];\n}\n// No modo primeira conta existe no máximo uma linha pendente: outro e-mail\n// reaproveita essa mesma linha, pra um e-mail digitado errado não deixar um\n// convite de acesso total sobrando na tabela.\nif (!alvo && primeiraConta) {\n  alvo = registros.find((r) => !temSenha(r)) || null;\n}\n\nconst codigo = String(crypto.randomInt(0, 1000000)).padStart(6, '0');\nconst campos = {\n  Codigo_Recuperacao_Hash: crypto.createHash('sha256').update(codigo).digest('hex'),\n  Codigo_Expira_Em: new Date(Date.now() + 10 * 60 * 1000).toISOString(),\n  Codigo_Tentativas: 0,\n};\nif (primeiraConta) {\n  campos.Email = entrada.email;\n  campos.Papel = 'Dono';\n  campos.Ativo = false;\n}\n\nreturn [{\n  json: {\n    acao: 'enviar',\n    metodo: alvo ? 'PATCH' : 'POST',\n    url: 'https://api.airtable.com/v0/' + BASE + '/' + TABELA + (alvo ? '/' + alvo.id : ''),\n    corpo: { fields: campos },\n    email: entrada.email,\n    nome: (alvo && alvo.fields && alvo.fields.Nome) || '',\n    codigo,\n    modo: primeiraConta ? 'primeira_conta' : 'convite',\n  },\n}];\n"
      },
