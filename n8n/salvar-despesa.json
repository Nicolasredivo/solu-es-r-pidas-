    {
      "parameters": {
        "jsCode": "// Limpa o que veio do app antes de gravar. Descricao e Valor sao\n// obrigatorios; o resto e opcional.\nconst b = $json.body || {};\nconst texto = (v) => String(v ?? '').trim();\nconst lista = (v) => texto(v) || null;\nconst numero = (v) => {\n  const n = Number(String(v ?? '').replace(',', '.'));\n  return Number.isFinite(n) ? n : null;\n};\n\nconst descricao = texto(b.descricao);\nconst valor = numero(b.valor);\n\nif (!descricao || valor === null) {\n  return [{ json: { valido: false, mensagem: 'Preencha a descrição e um valor válido.' } }];\n}\n\nreturn [{\n  json: {\n    valido: true,\n    descricao,\n    valor,\n    fornecedor: texto(b.fornecedor),\n    vencimento: lista(b.vencimento),\n    status: lista(b.status) || 'Pendente',\n    categoria: lista(b.categoria) || 'Outros',\n    dataPagamento: lista(b.dataPagamento),\n    observacoes: texto(b.observacoes),\n  },\n}];"
      },
