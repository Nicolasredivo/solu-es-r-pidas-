        "jsCode": "const achados = $input.all().filter((i) => i.json && i.json.id && !i.json.error);\n\nconst cartoes = achados.map((i) => {\n  const f = i.json.fields || {};\n  return {\n    id: i.json.id,\n    nome: f.Nome || \"\",\n    banco: f.Banco || \"\",\n    bandeira: f.Bandeira || \"\",\n    final: f.Final || \"\",\n    chavePix: f.Chave_PIX || \"\",\n    tipoChavePix: f.Tipo_Chave_PIX || \"\",\n    diaFechamento: f.Dia_Fechamento || 1,\n    diaVencimento: f.Dia_Vencimento || 10,\n    limite: f.Limite || 0,\n    // O Airtable nao devolve caixinha desmarcada, entao ausente = desmarcada.\n    ativo: Boolean(f.Ativo),\n    observacoes: f.Observacoes || \"\",\n  };\n});\n\nreturn [{ json: { ok: true, cartoes } }];"
