      "parameters": {
        "jsCode": "// Chave \"Nota fiscal / Apenas recibo\" do cliente (18/11/2026). Grava só a exigência fiscal, nada mais do cadastro.\nconst b = $json.body || {};\nconst id = String(b.id || '').trim();\nconst valor = String(b.exigencia || '').trim();\nif (!/^rec[A-Za-z0-9]{14}$/.test(id)) return [{ json: { ok: false, mensagem: 'Pedido sem o código do cliente.' } }];\nif (valor !== 'nota' && valor !== 'recibo') return [{ json: { ok: false, mensagem: 'Escolha inválida: diga se é nota fiscal ou apenas recibo.' } }];\nreturn [{ json: { ok: true, id, exigencia: valor === 'nota' ? 'Exige Nota Fiscal' : 'Apenas Recibo' } }];"
      }
    },
