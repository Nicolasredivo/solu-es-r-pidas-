      "id": "c0000000-0000-4000-8000-000000000004",
      "name": "Senha esta correta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"ok\": false,\n  \"mensagem\": \"Senha incorreta.\"\n}",
        "options": {}
      },
      "id": "c0000000-0000-4000-8000-000000000005",
      "name": "Responde senha incorreta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst texto = (v) => String(v ?? \"\").trim();\nconst id = texto(b.id);\nconst nome = texto(b.nome);\nif (!nome) throw new Error(\"Fornecedor sem nome.\");\n\nconst fields = { Nome: nome, CNPJ: texto(b.cnpj).replace(/\\D/g, \"\") };\nif (texto(b.observacoes)) fields.Observacoes = texto(b.observacoes);\n\nconst ehExistente = /^rec[A-Za-z0-9]{14}$/.test(id);\nreturn [{\n  json: {\n    metodo: ehExistente ? \"PATCH\" : \"POST\",\n    url: \"https://api.airtable.com/v0/appjAmWXV7Zr33UqE/tblhsabIIg8SLqMMj\",\n    corpo: { typecast: true, records: [ehExistente ? { id, fields } : { fields }] },\n  },\n}];"
      },
      "id": "c0000000-0000-4000-8000-000000000006",
      "name": "Monta a chamada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -60
      ]
    },
    {
      "parameters": {
        "method": "={{ $json.metodo }}",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.corpo || {}) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "c0000000-0000-4000-8000-000000000007",
      "name": "Grava no Airtable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -60
      ],
      "credentials": {
        "airtableTokenApi": {
          "id": "IJB0DgRAc1qPMkVm",
          "name": "Airtable Personal Access Token account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// O app precisa do codigo do registro para ligar a despesa a ele.\nconst criado = ($json.records || [])[0] || {};\nreturn [{\n  json: {\n    ok: true,\n    mensagem: \"Fornecedor salvo!\",\n    fornecedor: {\n      id: criado.id || \"\",\n      nome: (criado.fields || {}).Nome || \"\",\n      cnpj: (criado.fields || {}).CNPJ || \"\",\n    },\n  },\n}];"
      },
      "id": "c0000000-0000-4000-8000-000000000008",
      "name": "Devolve o fornecedor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -160
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "c0000000-0000-4000-8000-000000000009",
      "name": "Responde ao app",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        -160
      ]
    },
    {
