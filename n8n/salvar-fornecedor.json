        "responseBody": "{\n  \"ok\": false,\n  \"mensagem\": \"Não consegui salvar o fornecedor.\"\n}",
        "options": {}
      },
      "id": "c0000000-0000-4000-8000-000000000010",
      "name": "Responde erro",
