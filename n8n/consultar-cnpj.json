      "id": "c0000000-0000-4000-8000-000000000010",
      "name": "Consulta a Receita",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -160
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2500
    },
    {
      "parameters": {
        "jsCode": "// Mesma logica ja usada no cadastro: a Receita limita consultas por minuto\n// e responde 429. Nesse caso vale insistir; CNPJ que nao existe, nao.\nconst receita = $json || {};\nconst achou = Boolean(receita.razao_social);\nconst textoErro = receita.error ? JSON.stringify(receita.error) : \"\";\nconst excedeuLimite = /429|too many requests/i.test(textoErro);\n\nreturn [{\n  json: {\n    ok: true,\n    achou,\n    razaoSocial: receita.razao_social || \"\",\n    nomeFantasia: receita.nome_fantasia || \"\",\n    aviso: achou\n      ? null\n      : excedeuLimite\n        ? \"Muitas consultas seguidas à Receita. Espere um minuto e tente de novo.\"\n        : \"Não encontrei este CNPJ na Receita. Escreva o nome à mão.\",\n    podeTentarDeNovo: !achou && excedeuLimite,\n  },\n}];"
      },
