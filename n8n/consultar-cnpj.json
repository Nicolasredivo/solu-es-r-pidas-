    {
      "parameters": {
        "jsCode": "// So consulta a Receita se o numero tiver cara de CNPJ. Assim um digito\n// a menos nao vira uma chamada perdida (e a Receita limita por minuto).\nconst digitos = String($json.body.cnpj || \"\").replace(/\\D/g, \"\");\n\nfunction cnpjValido(cnpj) {\n  if (cnpj.length !== 14 || /^(\\d)\\1{13}$/.test(cnpj)) return false;\n  const dv = (pesos) => {\n    const soma = pesos.reduce((t, p, i) => t + Number(cnpj[i]) * p, 0);\n    const resto = soma % 11;\n    return resto < 2 ? 0 : 11 - resto;\n  };\n  return dv([5,4,3,2,9,8,7,6,5,4,3,2]) === Number(cnpj[12])\n    && dv([6,5,4,3,2,9,8,7,6,5,4,3,2]) === Number(cnpj[13]);\n}\n\nreturn [{ json: { valido: cnpjValido(digitos), documento: digitos } }];"
      },
      "id": "c0000000-0000-4000-8000-000000000006",
