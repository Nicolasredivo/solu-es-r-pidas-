    {
      "parameters": {
        "jsCode": "const usuario = $('Busca usuario').first().json;\nconst quem = (usuario && usuario.fields && usuario.fields.Nome) || 'senha de acesso';\nconst agora = new Date().toISOString();\nconst hora = (iso) => new Date(iso).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\nconst comLinha = (historico, linha) => (historico ? historico + '\\n' : '') + agora + ' -- ' + linha;\nconst recusa = (mensagem) => [{ json: { pode: false, resposta: { ok: false, mensagem } } }];\nconst entrada = $('Le entrada').first().json;\nconst visita = $('Busca visita p/ concluir').first().json;\nconst chamado = $input.first().json;\nconst v = visita.fields || {};\nconst f = chamado.fields || {};\nif (v.Situacao !== 'Em andamento') return recusa('Esse atendimento já foi encerrado.');\n\nconst orcamento = f.Tipo_Chamado === 'Orçamento';\nconst periodo = ' (' + hora(v.Inicio_Real) + ' às ' + hora(agora) + ')';\nconst camposChamado = {};\nlet novoStatus = f.Status || '';\nlet horarioReal = null; // só atendimento normal concluído: o que a Agenda passa a mostrar\nif (f.Status === 'Cancelado') {\n  // Cancelado no meio do caminho: fecha só a visita, não ressuscita o chamado.\n  camposChamado.Historico = comLinha(f.Historico, 'Visita encerrada por ' + quem + periodo + '.');\n} else if (orcamento) {\n  // Visita de orçamento feita: o próximo passo é mandar o preço, e a execução\n  // (se aprovada) ganha agendamento novo. Volta pra fila, sem data.\n  novoStatus = 'Aguardando confirmação de data';\n  Object.assign(camposChamado, {\n    Status: novoStatus, Reservado_Inicio: null, Reservado_Fim: null,\n    Historico: comLinha(f.Historico, 'Visita de orçamento encerrada por ' + quem + periodo + '. Voltou pra fila até o orçamento ser enviado.'),\n  });\n} else {\n  novoStatus = 'Concluído';\n  // Concluído continua na Agenda (cinza, editável). O bloco passa a mostrar o horário\n  // REAL da visita; o previsto fica anotado no histórico. Fim nunca antes de 1 min\n  // depois do início real (a Agenda exige fim depois do início).\n  const fimReal = new Date(Math.max(new Date(agora).getTime(), new Date(v.Inicio_Real).getTime() + 60000)).toISOString();\n  horarioReal = { reservadoInicio: v.Inicio_Real, reservadoFim: fimReal };\n  const previsto = f.Reservado_Inicio && f.Reservado_Fim\n    ? 'previsto ' + hora(f.Reservado_Inicio) + ' às ' + hora(f.Reservado_Fim) : 'sem horário previsto';\n  Object.assign(camposChamado, {\n    Status: novoStatus,\n    Reservado_Inicio: horarioReal.reservadoInicio, Reservado_Fim: horarioReal.reservadoFim,\n    Historico: comLinha(f.Historico, 'Atendimento concluído por ' + quem + periodo + '. A Agenda passou a mostrar o horário real (' + previsto + ').'),\n  });\n}\n\nreturn [{\n  json: {\n    pode: true,\n    chamadoId: chamado.id,\n    novoStatus,\n    orcamento,\n    horarioReal,\n    patchChamado: { typecast: true, records: [{ id: chamado.id, fields: camposChamado }] },\n    patchVisita: { typecast: true, records: [{ id: visita.id, fields: {\n      Situacao: 'Concluída', Fim_Real: agora, Resumo: entrada.resumo,\n      Recebido_Por: entrada.recebidoPor, Concluido_Por: quem,\n    } }] },\n  },\n}];"
      },
