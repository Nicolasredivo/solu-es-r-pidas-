    {
      "parameters": {
        "jsCode": "const usuario = $('Busca usuario').first().json;\nconst quem = (usuario && usuario.fields && usuario.fields.Nome) || 'senha de acesso';\nconst agora = new Date().toISOString();\nconst hora = (iso) => new Date(iso).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\nconst comLinha = (historico, linha) => (historico ? historico + '\\n' : '') + agora + ' -- ' + linha;\nconst recusa = (mensagem) => [{ json: { pode: false, resposta: { ok: false, mensagem } } }];\nconst entrada = $('Le entrada').first().json;\nconst r = $input.first().json;\nif (!r || !r.id) return recusa('Chamado não encontrado.');\nconst f = r.fields || {};\nconst status = f.Status || '';\n\nif (status === 'Em andamento') return recusa('Esse chamado já está em andamento.');\nif (status === 'Concluído' || status === 'Cancelado') return recusa('Esse chamado já está ' + status.toLowerCase() + '.');\nif (!f.Reservado_Inicio) return recusa('Esse chamado ainda não está na agenda.');\n// Só começa com data confirmada -- ou confirmando agora, no mesmo toque.\nif (status !== 'Agendado' && !(status === 'Aguardando confirmação de data' && entrada.confirmarData)) {\n  return recusa('Confirme a data do chamado antes de iniciar.');\n}\n\nconst orcamento = f.Tipo_Chamado === 'Orçamento';\nconst rotulo = new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }).replace(',', '');\nconst linha = (orcamento ? 'Visita de orçamento iniciada' : 'Atendimento iniciado') + ' por ' + quem\n  + (status !== 'Agendado' ? ' (data confirmada na hora)' : '') + '.';\n\nreturn [{\n  json: {\n    pode: true,\n    chamadoId: r.id,\n    // Pra voltar atrás se a visita não puder ser criada.\n    desfazChamado: { typecast: true, records: [{ id: r.id, fields: { Status: status, Historico: f.Historico || '' } }] },\n    patchChamado: { typecast: true, records: [{ id: r.id, fields: { Status: 'Em andamento', Historico: comLinha(f.Historico, linha) } }] },\n    criaVisita: { typecast: true, records: [{ fields: {\n      Visita: 'Chamado #' + (f.Numero_Chamado || '') + ' — ' + rotulo,\n      Chamado: [r.id], Situacao: 'Em andamento', Inicio_Real: agora, Iniciado_Por: quem,\n    } }] },\n    inicioReal: agora,\n    iniciadoPor: quem,\n  },\n}];"
      },
