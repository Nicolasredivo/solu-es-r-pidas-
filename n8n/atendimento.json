      "parameters": {
        "jsCode": "const corpo = $('Recebe pedido do app').first().json.body || {};\nconst acesso = $('Confere acesso').first().json;\nconst texto = (v) => String(v ?? '').trim();\nconst id = (v) => (/^rec[A-Za-z0-9]{14}$/.test(texto(v)) ? texto(v) : '');\n\nconst ACOES = ['listar', 'iniciar', 'desfazer', 'concluir'];\nconst acao = ACOES.includes(texto(corpo.acao)) ? texto(corpo.acao) : '';\nconst chamadoId = id(corpo.chamadoId);\nconst visitaId = id(corpo.visitaId);\nconst resumo = texto(corpo.resumo).slice(0, 5000);\n\nlet erro = '';\nif (!acao) erro = 'Ação inválida.';\nelse if (acao === 'iniciar' && !chamadoId) erro = 'Chamado inválido.';\nelse if ((acao === 'desfazer' || acao === 'concluir') && !visitaId) erro = 'Atendimento inválido.';\nelse if (acao === 'concluir' && !resumo) erro = 'Escreva o que foi feito.';\n\nreturn [{\n  json: {\n    acao, chamadoId, visitaId, resumo,\n    recebidoPor: texto(corpo.recebidoPor).slice(0, 120),\n    confirmarData: texto(corpo.confirmarData) === 'true',\n    usuarioId: acesso.usuarioId || '',\n    erro,\n  },\n}];"
      },
