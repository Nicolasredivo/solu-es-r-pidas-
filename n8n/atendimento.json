      "id": "a7e00000-0000-4000-8000-000000000036",
      "name": "Busca chamado p/ concluir",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        500
      ],
      "credentials": {
        "airtableTokenApi": {
