    {
      "parameters": {
        "jsCode": "const usuario = $('Busca usuario').first().json;\nconst quem = (usuario && usuario.fields && usuario.fields.Nome) || 'senha de acesso';\nconst agora = new Date().toISOString();\nconst hora = (iso) => new Date(iso).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\nconst comLinha = (historico, linha) => (historico ? historico + '\\n' : '') + agora + ' -- ' + linha;\nconst recusa = (mensagem) => [{ json: { pode: false, resposta: { ok: false, mensagem } } }];\nconst visita = $('Busca visita').first().json;\nconst chamado = $input.first().json;\nconst v = visita.fields || {};\nconst f = chamado.fields || {};\nif (v.Situacao !== 'Em andamento') return recusa('Esse atendimento já foi encerrado.');\n// Desfazer é pra toque errado: vale só logo depois de iniciar.\nif (Date.now() - new Date(v.Inicio_Real).getTime() > 15 * 60 * 1000) {\n  return recusa('Já passou muito tempo pra desfazer. Encerre o atendimento normalmente.');\n}\nconst patch = { typecast: true, records: [{ id: chamado.id, fields: { Historico: comLinha(f.Historico, 'Início desfeito por ' + quem + '.') } }] };\n// Só devolve pra \"Agendado\" se ainda estiver em andamento (ninguém mudou no meio).\nif (f.Status === 'Em andamento') patch.records[0].fields.Status = 'Agendado';\nreturn [{ json: { pode: true, visitaId: visita.id, chamadoId: chamado.id, patchChamado: patch } }];"
