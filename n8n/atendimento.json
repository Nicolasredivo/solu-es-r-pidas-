    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.airtable.com/v0/app6PyYmtFduIMp7B/tbltipxOIw8F96QHO/' + ((($json.fields || {}).Chamado || [])[0] || 'recNaoExiste00000') }}",
