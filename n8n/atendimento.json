      "parameters": {
        "jsCode": "const itens = $input.all().map((i) => i.json);\n// Airtable fora do ar não pode parecer \"nenhum atendimento em andamento\".\nif (itens.some((j) => j && j.error)) {\n  return [{ json: { ok: false, mensagem: 'Não foi possível carregar os atendimentos agora.' } }];\n}\nconst visitas = itens\n  .filter((j) => j && j.id)\n  .map((j) => {\n    const f = j.fields || {};\n    return {\n      id: j.id,\n      chamadoId: (f.Chamado || [])[0] || '',\n      inicioReal: f.Inicio_Real || '',\n      iniciadoPor: f.Iniciado_Por || '',\n    };\n  })\n  .filter((v) => v.chamadoId);\nreturn [{ json: { ok: true, visitas } }];"
      },
