    {
      "parameters": {
        "jsCode": "// Junta tudo num objeto so, tabela por tabela, com os registros crus do\n// Airtable (id + fields). Cru de proposito: da para reconstruir a partir dele.\nconst tabelas = [[\"Financeiro\",\"Despesas\",\"Le Despesas\"],[\"Financeiro\",\"Fornecedores\",\"Le Fornecedores\"],[\"Financeiro\",\"Recorrentes\",\"Le Recorrentes\"],[\"Financeiro\",\"Recebimentos\",\"Le Recebimentos\"],[\"Financeiro\",\"Config_Financeiro\",\"Le Config_Financeiro\"],[\"Financeiro\",\"Conferencias\",\"Le Conferencias\"],[\"Financeiro\",\"Retiradas\",\"Le Retiradas\"],[\"Financeiro\",\"Cartoes\",\"Le Cartoes\"],[\"Financeiro\",\"Pagamentos_Fatura\",\"Le Pagamentos_Fatura\"],[\"cadastro\",\"Entidades_Cadastradas\",\"Le Entidades_Cadastradas\"],[\"cadastro\",\"Contatos_Solicitantes\",\"Le Contatos_Solicitantes\"],[\"cadastro\",\"Locais_Atendimento\",\"Le Locais_Atendimento\"],[\"ERP\",\"Atendimentos\",\"Le Atendimentos\"]];\nconst dados = {};\nlet total = 0;\n\nfor (const [base, tabela, no] of tabelas) {\n  let itens = [];\n  try { itens = $(no).all(); } catch (e) { itens = []; }\n  const registros = itens\n    .map((i) => i.json)\n    .filter((j) => j && j.id)\n    .map((j) => ({ id: j.id, createdTime: j.createdTime, fields: j.fields || {} }));\n  dados[base + \" / \" + tabela] = registros;\n  total += registros.length;\n}\n\nconst agora = new Date();\n// Horario de Brasilia, para o nome do arquivo bater com o dia de verdade.\nconst br = new Date(agora.getTime() - 3 * 60 * 60 * 1000);\nconst dia = br.toISOString().slice(0, 10);\n\nreturn [{ json: {\n  feito_em: agora.toISOString(),\n  dia: dia,\n  total_de_registros: total,\n  tabelas: Object.fromEntries(Object.entries(dados).map(([k, v]) => [k, v.length])),\n  dados: dados,\n} }];"
      },
