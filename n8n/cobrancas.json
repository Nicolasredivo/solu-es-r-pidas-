    {
      "id": "22022a24-305e-4dbf-8584-6a85f2d46e67",
      "name": "Le entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Tudo chega como texto (o app manda formulário simples). Só passa o que tem o formato certo; o banco confere o resto.\nconst b = $('Recebe pedido do app').first().json.body || {};\nconst t = (v) => String(v ?? '').replace(/[\\u0000-\\u001f\\u007f]/g, ' ').trim();\nconst ACOES = ['painel', 'historico', 'preparar', 'criar', 'ligar-nota', 'registrar-nota', 'registrar-recibo', 'baixa', 'prorrogar', 'cancelar', 'conciliar', 'ignorar', 'incluir-antigas', 'sincronizar'];\nconst acao = ACOES.includes(t(b.acao)) ? t(b.acao) : '';\nconst REC = /^rec[A-Za-z0-9]{14}$/;\nconst GRUPO = /^[A-Za-z0-9-]{8,64}$/;\nconst id = (v) => (REC.test(t(v)) ? t(v) : '');\nconst data = (v) => (/^\\d{4}-\\d{2}-\\d{2}$/.test(t(v)) ? t(v) : '');\nconst num = (v) => { let s = t(v); if (s.includes(',')) s = s.replace(/\\./g, '').replace(',', '.'); return /^\\d{1,9}(\\.\\d{1,2})?$/.test(s) ? Number(s) : null; };\nconst lista = (v, f) => { try { const a = JSON.parse(t(v) || '[]'); return Array.isArray(a) ? a.map(f).filter(Boolean).slice(0, 60) : []; } catch (e) { return []; } };\nconst p = { acao };\nlet erro = '';\nif (!acao) erro = 'Ação inválida.';\nif (['historico', 'baixa', 'prorrogar', 'cancelar'].includes(acao)) { p.id = id(b.id); if (!p.id) erro = 'Cobrança inválida.'; }\nif (acao === 'preparar' || acao === 'criar') {\n  p.clienteId = id(b.clienteId); p.valor = num(b.valor); p.material = num(b.material) || 0;\n  p.parcelas = Math.max(1, Math.min(12, parseInt(t(b.parcelas), 10) || 1));\n  p.vencimentos = lista(b.vencimentos, data);\n  if (!p.clienteId) erro = 'Escolha o cliente.'; else if (!p.valor) erro = 'Confira o valor.';\n  if (acao === 'criar') {\n    p.grupo = GRUPO.test(t(b.grupo)) ? t(b.grupo) : '';\n    p.origem = ['nota', 'recibo'].includes(t(b.origem)) ? t(b.origem) : 'avulsa';\n    // Desde 21/11/2026 o boleto nasce da conta que a nota (ou o recibo) já criou no A receber.\n    if (t(b.recebimentoId)) { p.recebimentoId = id(b.recebimentoId); if (!erro && !p.recebimentoId) erro = 'Conta inválida.'; }\n    p.servico = t(b.servico).replace(/\\s+/g, ' ').slice(0, 300);\n    if (!erro && !p.grupo) erro = 'Pedido sem identificação: recarregue a página.';\n    if (!erro && !p.servico) erro = 'Escreva o serviço.';\n  }\n}\nif (acao === 'ligar-nota') { p.grupo = GRUPO.test(t(b.grupo)) ? t(b.grupo) : ''; p.notaId = id(b.notaId); if (!p.grupo || !p.notaId) erro = 'Faltou a nota ou o boleto.'; }\nif (acao === 'registrar-nota') { p.notaId = id(b.notaId); if (!p.notaId) erro = 'Nota inválida.'; }\nif (acao === 'registrar-recibo') { p.arquivoId = id(b.arquivoId); if (!p.arquivoId) erro = 'Recibo inválido.'; }\nif (acao === 'baixa') { p.data = data(b.data); p.valor = num(b.valor); p.forma = ['PIX', 'Boleto', 'Dinheiro', 'Transferência', 'Cartão'].includes(t(b.forma)) ? t(b.forma) : ''; if (!erro && !p.valor) erro = 'Falta o valor recebido.'; }\nif (acao === 'prorrogar') { p.vencimento = data(b.vencimento); if (!erro && !p.vencimento) erro = 'Escolha a data nova.'; }\nif (acao === 'conciliar') { p.conciliacaoId = id(b.conciliacaoId); p.id = id(b.id); if (!p.conciliacaoId || !p.id) erro = 'Escolha a cobrança desta entrada.'; }\nif (acao === 'ignorar') { p.conciliacaoId = id(b.conciliacaoId); p.texto = t(b.texto).replace(/\\s+/g, ' ').slice(0, 300); if (!p.conciliacaoId) erro = 'Entrada inválida.'; }\nif (acao === 'incluir-antigas') { p.receber = lista(b.receber, id); p.recebidas = lista(b.recebidas, id); if (!p.receber.length && !p.recebidas.length) erro = 'Escolha as notas.'; }\nreturn [{ json: { ok: !erro, erro, p } }];"
      }
    },
