    {
      "name": "Responde acesso negado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        380
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"ok\": false, \"acessoNegado\": true, \"mensagem\": \"Acesso não autorizado. Entre de novo.\" }",
        "options": {}
