      "id": "6630de39-c466-4b1c-a2cb-552fba0eadcc"
    },
    {
      "name": "Chama Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2026-10-21"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'claude-haiku-5-5',\n  max_tokens: 500,\n  thinking: { type: 'disabled' },\n  output_config: { effort: 'low' },\n  system: \"Você revisa textos curtos de documentos de uma empresa de manutenção predial (recibos, notas, orçamentos). Corrija ortografia, acentuação, concordância e pontuação e deixe o texto técnico, formal e enxuto, com os termos certos do ofício. Não invente nada e não tire informação: mantenha quantidades, locais, materiais, medidas e valores. Siga o Acordo Ortográfico vigente (boia, ideia, para, sem acento). Prefira termos técnicos (substituição, instalação, reparo, vazamento) e expanda abreviações óbvias. Responda só com o texto final, numa linha, sem aspas, título ou comentário.\",\n  messages: [{ role: 'user', content: $json.texto }]\n}) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "7ifJ8p9C8Qed93GB",
          "name": "Anthropic account"
        }
      },
      "id": "dee40a66-81f1-46b0-9a07-613c12071d83"
    },
    {
      "name": "Monta resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "jsCode": "// Resposta do Claude: só o texto. Recusa, erro ou chave faltando viram um aviso simples (nada muda no campo).\nconst r = $json || {};\nconst e = $('Le entrada').first().json;\nif (r.error || r.type === 'error') {\n  const msg = JSON.stringify(r.error || r).toLowerCase();\n  const semChave = /authentication|api[_ -]?key|401|credential/.test(msg);\n  return [{ json: { ok: false, mensagem: semChave ? 'Falta a chave da Anthropic no n8n (credencial \"Anthropic\").' : 'O aprimorador não respondeu agora. Tente de novo em instantes.' } }];\n}\nif (r.stop_reason === 'refusal') return [{ json: { ok: false, mensagem: 'O aprimorador não quis mexer neste texto. Ajuste à mão.' } }];\nconst texto = (Array.isArray(r.content) ? r.content : []).filter((c) => c.type === 'text').map((c) => c.text).join(' ')\n  .replace(/\\s+/g, ' ').trim().replace(/^[\"'“”]+|[\"'“”]+$/g, '');\nif (!texto) return [{ json: { ok: false, mensagem: 'O aprimorador voltou vazio. Tente de novo.' } }];\n// Grafias antigas que às vezes escapam (Acordo Ortográfico): corrigidas aqui, sem gastar outra chamada.\nconst ACORDO = [[/b[óo]ia/g, 'boia'], [/B[óo]ia/g, 'Boia'], [/id[ée]ia/g, 'ideia'], [/Id[ée]ia/g, 'Ideia'], [/vôo/g, 'voo'], [/assembl[ée]ia/g, 'assembleia'], [/Assembl[ée]ia/g, 'Assembleia']];\nlet final = texto;\nfor (const [de, para] of ACORDO) final = final.replace(de, para);\nreturn [{ json: { ok: true, texto: final.slice(0, 1200), original: e.texto,\n  custo: { entrada: (r.usage || {}).input_tokens || 0, saida: (r.usage || {}).output_tokens || 0 } } }];"
      },
      "id": "7674c779-4997-4314-bcd5-ad9d8e64592d"
    },
    {
      "name": "Responde",
