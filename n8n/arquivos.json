    {
      "id": "a3b17579-6945-4d67-9411-74f36aa97af2",
      "name": "Monta leitura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        20
      ],
      "parameters": {
        "jsCode": "const e = $('Le entrada').first().json;\nconst cab = $('Recebe pedido do app').first().json.headers || {};\n// Anexo guardado no PC vem com endereço relativo (/webhook/anexo...): completa com o endereço por onde o app\n// chegou (o túnel), senão o PDF não abre no celular.\nconst origem = String(cab['x-forwarded-proto'] || 'http').split(',')[0].trim() + '://' + (cab['x-forwarded-host'] || cab.host || 'localhost:5678');\nconst urlAnexo = (u) => (String(u || '').startsWith('/') ? origem + u : u);\nconst lista = (no) => { try { return $(no).all().map((i) => i.json).filter((j) => j && j.id && j.fields); } catch (err) { return []; } };\nconst falhou = (no) => { try { return $(no).all().some((i) => i.json && i.json.error); } catch (err) { return false; } };\nif (falhou('Busca arquivos') || falhou('Busca notas')) return [{ json: { ok: false, mensagem: 'Não foi possível falar com o banco agora. Tente de novo em instantes.' } }];\n\n// NFS-e: em produção só aparecem as notas de verdade; no ambiente de testes, só as de teste (igual à página de notas).\nlet saude = {};\ntry { saude = $('Status do servico').first().json || {}; } catch (err) { saude = {}; }\nconst ambiente = saude.ok === true && saude.ambiente === 'restrita' ? 'Testes' : 'Producao';\n\nconst arquivos = lista('Busca arquivos').map((r) => {\n  const f = r.fields;\n  const anexo = (f.Arquivo || [])[0] || null;\n  return { id: r.id, clienteId: f.Cliente_Ref || '', pasta: f.Tipo, titulo: f.Titulo || '', descricao: f.Descricao || '', data: f.Data_Documento || '',\n    valor: typeof f.Valor === 'number' ? f.Valor : null, emissor: f.Emissor || 'CNPJ 1',\n    texto: e.acao === 'cliente' ? String(f.Texto_Busca || '').slice(0, 4000) : '',\n    arquivo: anexo ? { nome: anexo.filename, url: urlAnexo(anexo.url), tamanho: anexo.size || 0 } : null };\n});\nconst notas = lista('Busca notas').filter((r) => r.fields.Status === 'Emitida' && r.fields.Ambiente === ambiente).map((r) => {\n  const f = r.fields;\n  return { id: r.id, clienteId: f.Cliente_Ref || '', pasta: 'nfs', titulo: f.Numero_NFSe ? 'Nota nº ' + f.Numero_NFSe : 'Nota (pedido nº ' + f.Numero_DPS + ')',\n    descricao: f.Descricao || '', data: f.Competencia || '', valor: typeof f.Valor === 'number' ? f.Valor : null, emissor: f.Emissor || 'CNPJ 1',\n    texto: e.acao === 'cliente' ? [f.Tomador_Nome, f.Obra, f.Descricao, f.Chave_Acesso].filter(Boolean).join(' | ').slice(0, 4000) : '',\n    nota: { chave: f.Chave_Acesso || '', numero: f.Numero_NFSe || '', tomador: f.Tomador_Nome || '', documento: f.Tomador_Documento || '', obra: f.Obra || '', ambiente: f.Ambiente } };\n});\nconst todos = arquivos.concat(notas);\n\nif (e.acao === 'resumo') {\n  const porCliente = {};\n  for (const it of todos) {\n    if (!it.clienteId) continue;\n    const c = (porCliente[it.clienteId] = porCliente[it.clienteId] || { total: 0, pastas: {} });\n    c.total++;\n    c.pastas[it.pasta] = (c.pastas[it.pasta] || 0) + 1;\n  }\n  return [{ json: { ok: true, ambiente, clientes: porCliente } }];\n}\nconst doCliente = todos.filter((it) => it.clienteId === e.clienteId).sort((a, b) => String(b.data).localeCompare(String(a.data)));\nreturn [{ json: { ok: true, ambiente, itens: doCliente } }];"
      }
    },
    {
      "id": "9c273c30-bf4d-436b-b8f8-33b76f0ef36c",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "const e = $('Le entrada').first().json;\nconst achados = $('Busca duplicado').all().map((i) => i.json).filter((j) => j && j.id && j.fields);\n// O mesmo PDF (mesma impressão digital) do mesmo cliente não é guardado duas vezes.\nconst dup = e.hash ? achados.find((r) => r.fields.Cliente_Ref === e.clienteId) : null;\nif (dup) return [{ json: { proximo: 'responder', resposta: { ok: true, jaGuardado: true, id: dup.id, mensagem: 'Esta cópia já estava guardada na pasta do cliente.' } } }];\nconst fields = {\n  Cliente_Ref: e.clienteId, Cliente_Nome: e.clienteNome, Tipo: e.tipo, Titulo: e.titulo, Descricao: e.descricao,\n  Texto_Busca: e.textoBusca, Data_Documento: e.dataDocumento, Emissor: e.emissor, Origem: e.origem, Dados_Json: e.dadosJson,\n};\nif (e.valor !== null) fields.Valor = e.valor;\nif (e.hash) fields.Hash_PDF = e.hash;\nreturn [{ json: { proximo: 'gravar', url: 'http://127.0.0.1:5690/v0/app6PyYmtFduIMp7B/tblArquivosClie01', corpo: { fields } } }];"
      }
    },
