    {
      "id": "bc221eb9-cba6-4e23-891a-5c38124cf7f3",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "const e = $('Le entrada').first().json;\nconst achados = $('Busca duplicado').all().map((i) => i.json).filter((j) => j && j.id && j.fields);\n// O mesmo PDF (mesma impressão digital) do mesmo cliente não é guardado duas vezes.\nconst dup = e.hash ? achados.find((r) => r.fields.Cliente_Ref === e.clienteId) : null;\nif (dup) return [{ json: { proximo: 'responder', resposta: { ok: true, jaGuardado: true, id: dup.id, mensagem: 'Esta cópia já estava guardada na pasta do cliente.' } } }];\nconst fields = {\n  Cliente_Ref: e.clienteId, Cliente_Nome: e.clienteNome, Tipo: e.tipo, Titulo: e.titulo, Descricao: e.descricao,\n  Texto_Busca: e.textoBusca, Data_Documento: e.dataDocumento, Emissor: e.emissor, Origem: 'gerado', Dados_Json: e.dadosJson,\n};\nif (e.valor !== null) fields.Valor = e.valor;\nif (e.hash) fields.Hash_PDF = e.hash;\nreturn [{ json: { proximo: 'gravar', url: 'http://127.0.0.1:5690/v0/app6PyYmtFduIMp7B/tblArquivosClie01', corpo: { fields } } }];"
      }
