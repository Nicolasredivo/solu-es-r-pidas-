    {
      "id": "b04a15c1-8cc1-4339-89c4-5393c7996c04",
      "name": "Le entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Tudo chega como texto (o app manda formulário simples).\nconst corpo = $('Recebe pedido do app').first().json.body || {};\nconst texto = (v) => String(v ?? '').trim();\nconst ACOES = ['salvar', 'resumo', 'cliente'];\nconst acao = ACOES.includes(texto(corpo.acao)) ? texto(corpo.acao) : '';\nlet erro = acao ? '' : 'Ação inválida.';\n\n// Por enquanto só os PDFs gerados no app; \"servico\" e \"relatorio_tecnico\" entram quando forem definidos.\nconst TIPOS = ['nfs', 'orcamento', 'recibo', 'comunicado', 'laudo'];\nconst ORIGENS = ['gerado', 'importado'];\nconst origem = texto(corpo.origem) || 'gerado';\nconst clienteId = texto(corpo.clienteId);\nconst tipo = texto(corpo.tipo);\nconst titulo = texto(corpo.titulo).replace(/\\s+/g, ' ').slice(0, 200);\nconst descricao = texto(corpo.descricao).replace(/\\s+/g, ' ').slice(0, 500);\nconst textoBusca = texto(corpo.textoBusca).slice(0, 20000);\nconst clienteNome = texto(corpo.clienteNome).replace(/\\s+/g, ' ').slice(0, 200);\nconst dataDocumento = texto(corpo.dataDocumento);\nconst emissor = texto(corpo.emissor) === 'CNPJ 2' ? 'CNPJ 2' : 'CNPJ 1';\nconst hash = texto(corpo.hash).toLowerCase();\nconst dadosJson = texto(corpo.dadosJson).slice(0, 100000);\n\n// Valor em reais: vazio = sem valor (comunicado e laudo não têm). Aceita 290 / 290,5 / 1.290,50 / 290.50.\nlet bruto = texto(corpo.valor).replace(/\\s+/g, '').replace(/^R\\$/i, '');\nif (bruto.includes(',')) bruto = bruto.replace(/\\./g, '').replace(',', '.');\nlet valor = null;\nif (bruto) {\n  if (/^\\d{1,9}(\\.\\d{1,2})?$/.test(bruto)) valor = Number(bruto);\n  else if (!erro) erro = 'Valor inválido.';\n}\n\n// PDF em base64, até uns 8 MB.\nlet arquivo = texto(corpo.arquivo).replace(/^data:[^,]*,/, '');\nlet nomeArquivo = texto(corpo.nomeArquivo).replace(/[\\\\/:*?\"<>|\\x00-\\x1f]/g, '_').slice(0, 150) || 'documento.pdf';\nif (!/\\.pdf$/i.test(nomeArquivo)) nomeArquivo += '.pdf';\n\nif (!erro && !/^rec[A-Za-z0-9]{14}$/.test(clienteId) && acao !== 'resumo') erro = 'Escolha um cliente do cadastro.';\nif (!erro && acao === 'salvar') {\n  if (!TIPOS.includes(tipo)) erro = 'Tipo de documento inválido.';\n  else if (!ORIGENS.includes(origem)) erro = 'Origem inválida.';\n  else if (!titulo) erro = 'Falta o título do documento.';\n  else if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(dataDocumento)) erro = 'Data do documento inválida.';\n  else if (hash && !/^[0-9a-f]{64}$/.test(hash)) erro = 'Identificação do arquivo inválida.';\n  else if (!arquivo || !/^[A-Za-z0-9+/=]+$/.test(arquivo)) erro = 'Arquivo inválido.';\n  else if (!arquivo.startsWith('JVBERi0')) erro = 'O arquivo precisa ser um PDF.';\n  else if (arquivo.length > 11 * 1024 * 1024) erro = 'O PDF passa de 8 MB.';\n}\nreturn [{ json: { acao, origem, clienteId, tipo, titulo, descricao, textoBusca, clienteNome, dataDocumento, valor, emissor, hash, dadosJson, arquivo, nomeArquivo, erro } }];"
      }
    },
