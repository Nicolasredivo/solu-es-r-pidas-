        "method": "GET",
        "url": "={{ 'http://127.0.0.1:5690/v0/app6PyYmtFduIMp7B/tblArquivosClie01?_itens=1&fields%5B%5D=Cliente_Ref&fields%5B%5D=Hash_PDF&filterByFormula=' + encodeURIComponent(\"{Hash_PDF}='\" + ($('Le entrada').first().json.hash || 'sem-hash') + \"'\") }}"
