    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst texto = (v) => String(v ?? \"\").trim();\nconst lista = (v) => texto(v) || null;\nconst numero = (v) => {\n  const n = Number(String(v ?? \"\").replace(\",\", \".\"));\n  return Number.isFinite(n) ? n : null;\n};\n\nconst id = texto(b.id);\nif (!/^rec[A-Za-z0-9]{14}$/.test(id)) throw new Error(\"Pedido sem o codigo da despesa.\");\n\nconst descricao = texto(b.descricao);\nconst valor = numero(b.valor);\nif (!descricao || valor === null || valor <= 0) {\n  return [{ json: { invalido: true, mensagem: \"Preencha a descrição e um valor válido.\" } }];\n}\n\nconst fields = {\n  Descricao: descricao,\n  Valor: valor,\n  Vencimento: lista(b.vencimento),\n  Status: lista(b.status) || \"Pendente\",\n  Categoria: lista(b.categoria) || \"Outros\",\n  Forma_Pagamento: lista(b.formaPagamento),\n  Data_Pagamento: lista(b.dataPagamento),\n  Observacoes: texto(b.observacoes),\n};\n\n// Lista vazia desliga o vinculo; com codigo, aponta para o fornecedor.\nconst fornecedorId = texto(b.fornecedorId);\nfields.Fornecedor_Ref = /^rec[A-Za-z0-9]{14}$/.test(fornecedorId) ? [fornecedorId] : [];\n\nconst servicoId = texto(b.servicoId);\nfields.Servico_Ref = /^rec[A-Za-z0-9]{14}$/.test(servicoId) ? [servicoId] : [];\n\nconst cartaoId = texto(b.cartaoId);\nfields.Cartao_Ref = /^rec[A-Za-z0-9]{14}$/.test(cartaoId) ? [cartaoId] : [];\n\nreturn [{\n  json: {\n    invalido: false,\n    metodo: \"PATCH\",\n    url: \"https://api.airtable.com/v0/appjAmWXV7Zr33UqE/tblNduEKl2jY280V0\",\n    corpo: { typecast: true, records: [{ id, fields }] },\n  },\n}];"
      },
