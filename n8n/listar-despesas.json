    {
      "parameters": {
        "jsCode": "// Uma linha por despesa. O no de busca devolve item vazio (sem .id) quando\n// a tabela esta vazia, ou item de erro se a busca falhar -- os dois casos\n// ficam de fora da lista em vez de quebrar a resposta.\nconst achadas = $input.all().filter((i) => i.json && i.json.id && !i.json.error);\n\nconst despesas = achadas.map((i) => {\n  const f = i.json.fields || {};\n  return {\n    id: i.json.id,\n    descricao: f.Descricao || '',\n    valor: f.Valor || 0,\n    fornecedor: f.Fornecedor || '',\n    vencimento: f.Vencimento || '',\n    status: f.Status || 'Pendente',\n    categoria: f.Categoria || '',\n    dataPagamento: f.Data_Pagamento || '',\n    observacoes: f.Observacoes || '',\n  };\n});\n\nreturn [{ json: { ok: true, total: despesas.length, despesas } }];"
      },
