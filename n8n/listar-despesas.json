    {
      "parameters": {
        "jsCode": "// O no de busca devolve um item vazio quando a tabela esta vazia, ou um item\n// de erro se a busca falhou — os dois ficam de fora em vez de quebrar a lista.\nconst achadas = $input.all().filter((i) => i.json && i.json.id && !i.json.error);\nconst primeiro = (v) => (Array.isArray(v) ? (v[0] || \"\") : (v == null ? \"\" : String(v)));\n\nconst despesas = achadas.map((i) => {\n  const f = i.json.fields || {};\n  return {\n    id: i.json.id,\n    descricao: f.Descricao || \"\",\n    valor: f.Valor || 0,\n    fornecedorId: primeiro(f.Fornecedor_Ref),\n    fornecedor: primeiro(f.Fornecedor_Nome),\n    vencimento: f.Vencimento || \"\",\n    status: f.Status || \"Pendente\",\n    categoria: f.Categoria || \"\",\n    formaPagamento: f.Forma_Pagamento || \"\",\n    parcelaNumero: f.Parcela_Numero || 0,\n    parcelaTotal: f.Parcela_Total || 0,\n    grupo: f.Grupo || \"\",\n    recorrenteId: primeiro(f.Recorrente_Ref),\n    // Compra amarrada a um servico entra no custo dele, e sai do lucro.\n    servicoId: primeiro(f.Servico_Ref),\n    // Em qual cartao a compra caiu — e o que agrupa a fatura no painel.\n    cartaoId: primeiro(f.Cartao_Ref),\n    dataPagamento: f.Data_Pagamento || \"\",\n    observacoes: f.Observacoes || \"\",\n  };\n});\n\nreturn [{ json: { ok: true, total: despesas.length, despesas } }];"
      },
