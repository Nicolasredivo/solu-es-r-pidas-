    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst prep = $('Prepara verificacao').first().json;\nconst emitido = $input.first().json;\n\nconst tokenSessao = crypto.randomBytes(32).toString('hex');\nconst expiraEm = new Date(Date.now() + 60 * 24 * 60 * 60 * 1000).toISOString();\n\nreturn [{\n  json: {\n    usuarioId: prep.usuarioId,\n    nome: prep.nome,\n    papel: prep.papel,\n    dispositivo: prep.dispositivo,\n    tokenAcesso: emitido.tokenAcesso,\n    expiraEmSegundos: emitido.expiraEmSegundos,\n    tokenSessao,\n    expiraEmSessao: expiraEm\n  }\n}];\n"
      },
