    {
      "parameters": {
        "jsCode": "const corpo = $input.first().json.body || {};\nconst cabecalhos = $input.first().json.headers || {};\n\nconst email = String(corpo.email || '').trim().toLowerCase();\nconst senha = String(corpo.senha || '');\nconst dispositivo = String(corpo.dispositivo || cabecalhos['user-agent'] || '').slice(0, 200);\n\nconst emailEscapado = email.replace(/'/g, \"\\\\'\");\n\nreturn [{\n  json: {\n    email,\n    senha,\n    dispositivo,\n    formula: \"LOWER({Email}) = '\" + emailEscapado + \"'\"\n  }\n}];\n"
      },
