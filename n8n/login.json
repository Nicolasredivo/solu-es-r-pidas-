      "parameters": {
        "jsCode": "const registros = $input.all();\nconst entrada = $('Monta busca').first().json;\nconst registro = registros[0] && registros[0].json;\n\nif (!registro || !registro.id) {\n  return [{ json: { encontrado: false } }];\n}\n\nconst campos = registro.fields || {};\n\nreturn [{\n  json: {\n    encontrado: true,\n    usuarioId: registro.id,\n    nome: campos.Nome || '',\n    papel: campos.Papel || 'Usuario',\n    senhaHash: campos.Senha_Hash || '',\n    ativo: campos.Ativo === true,\n    senhaDigitada: entrada.senha,\n    dispositivo: entrada.dispositivo || ''\n  }\n}];\n"
      },
