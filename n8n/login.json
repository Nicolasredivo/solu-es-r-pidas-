        "jsonBody": "={{ JSON.stringify({ typecast: true, fields: { \"Token\": ($json.tokenSessao), \"Usuario\": ([$json.usuarioId]), \"Dispositivo\": ($json.dispositivo), \"Expira_Em\": ($json.expiraEmSessao) } }) }}",
