    {
      "parameters": {
        "jsCode": "// Limpa o que veio do app antes de gravar.\n// As listas do Airtable (Tipo, Exigencia, Status) recusam texto vazio,\n// entao mando null nesses casos, que o Airtable entende como 'em branco'.\nconst b = $json.body || {};\nconst texto = (v) => String(v ?? '').trim();\nconst lista = (v) => texto(v) || null;\n\nreturn [{\n  json: {\n    documento: texto(b.documento).replace(/\\D/g, ''),\n    razaoSocial: texto(b.razaoSocial),\n    nomeFantasia: texto(b.nomeFantasia),\n    tipo: lista(b.tipo),\n    exigenciaFiscal: lista(b.exigenciaFiscal),\n    emails: texto(b.emails),\n    whatsapp: texto(b.whatsapp),\n    administradora: texto(b.administradora),\n    status: lista(b.status) || 'Ativo',\n    observacoes: texto(b.observacoes),\n  },\n}];"
      },
