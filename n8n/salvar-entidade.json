    {
      "parameters": {
        "jsCode": "const DESEJADO = [{\"event\":\"PAYMENT_CREATED\",\"offset\":0,\"email\":true,\"sms\":false,\"whatsapp\":false,\"ligacao\":false},{\"event\":\"PAYMENT_UPDATED\",\"offset\":0,\"email\":false,\"sms\":false,\"whatsapp\":false,\"ligacao\":false},{\"event\":\"PAYMENT_DUEDATE_WARNING\",\"offset\":10,\"email\":true,\"sms\":false,\"whatsapp\":false,\"ligacao\":false},{\"event\":\"PAYMENT_DUEDATE_WARNING\",\"offset\":0,\"email\":false,\"sms\":false,\"whatsapp\":false,\"ligacao\":false},{\"event\":\"SEND_LINHA_DIGITAVEL\",\"offset\":0,\"email\":false,\"sms\":false,\"whatsapp\":false,\"ligacao\":false},{\"event\":\"PAYMENT_OVERDUE\",\"offset\":0,\"email\":true,\"sms\":false,\"whatsapp\":false,\"ligacao\":false},{\"event\":\"PAYMENT_OVERDUE\",\"offset\":7,\"email\":true,\"sms\":false,\"whatsapp\":false,\"ligacao\":false},{\"event\":\"PAYMENT_RECEIVED\",\"offset\":0,\"email\":false,\"sms\":false,\"whatsapp\":false,\"ligacao\":false}];\nconst lista = ($input.first().json || {}).data || [];\n\nconst itens = [];\nfor (const alvo of DESEJADO) {\n  const atual = lista.find((n) => n.event === alvo.event && n.scheduleOffset === alvo.offset);\n  if (!atual) continue;\n  itens.push({ json: {\n    url: \"https://api.asaas.com/v3/notifications/\" + atual.id,\n    corpo: {\n      emailEnabledForCustomer: alvo.email, smsEnabledForCustomer: alvo.sms,\n      whatsappEnabledForCustomer: alvo.whatsapp, phoneCallEnabledForCustomer: alvo.ligacao,\n    },\n  } });\n}\n// Se a Asaas mudar os nomes dos eventos algum dia e nada bater, ainda\n// precisa sair um item, senao o fluxo morre aqui e o app fica esperando.\nif (!itens.length) return [{ json: { semNotificacao: true } }];\nreturn itens;"
      },
