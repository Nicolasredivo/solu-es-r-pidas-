    {
      "parameters": {
        "jsCode": "const texto = (v) => String(v ?? \"\").trim();\nconst soDigitos = (v) => texto(v).replace(/[^0-9]/g, \"\");\n\n// Endereco guardado como um texto so: \"RUA X, 100, CEP 00000-000\", as vezes\n// com complemento no meio. Enquanto seguir esse padrao (e ele sempre seguiu\n// ate hoje, vindo da consulta a Receita), da para separar de volta. Se um dia\n// alguem digitar diferente, o CEP/numero saem vazios -- nao trava, so manda\n// incompleto para a Asaas.\nfunction separaEndereco(enderecoCompleto) {\n  const bruto = texto(enderecoCompleto);\n  const mCep = bruto.match(/CEP\\s*([0-9]{5}-?[0-9]{3})/i);\n  const postalCode = mCep ? mCep[1].replace(\"-\", \"\") : \"\";\n  const semCep = bruto.replace(/,?\\s*CEP\\s*[0-9-]+/i, \"\").trim();\n  const partes = semCep.split(\",\").map((p) => p.trim()).filter(Boolean);\n  return {\n    address: partes[0] || \"\",\n    addressNumber: partes[1] || \"\",\n    complement: partes.slice(2).join(\", \") || \"\",\n    postalCode,\n  };\n}\n\nfunction separaBairro(bairroCidade) {\n  return texto(String(bairroCidade || \"\").split(\"/\")[0]);\n}\n\n// Numero brasileiro sem o 55 na frente: e o formato que a Asaas espera em\n// mobilePhone. Sobra o DDD + numero.\nfunction celularAsaas(v) {\n  let d = soDigitos(v);\n  if (d.length > 11 && d.startsWith(\"55\")) d = d.slice(2);\n  return d;\n}\n\n// Monta o corpo da Asaas so com o que realmente tem valor: mandar chave com\n// string vazia e diferente de nao mandar a chave (a Asaas trataria como\n// \"apagar o que tinha\").\nfunction montaPayload({ razaoSocial, documento, emailNfe, emailsContato, whatsappContato, enderecoCompleto, bairroCidade }) {\n  const end = separaEndereco(enderecoCompleto);\n  const provincia = separaBairro(bairroCidade);\n  const celular = celularAsaas(whatsappContato);\n\n  // TODOS os e-mails (Financeiro/NF-e + todos os do contato), sem repetir.\n  // O primeiro vira o principal; o resto vai em additionalEmails, separados\n  // por virgula -- e assim que a Asaas aceita mais de um endereco extra.\n  const brutos = [texto(emailNfe)].concat(Array.isArray(emailsContato) ? emailsContato.map(texto) : []);\n  const semRepetir = [];\n  brutos.filter(Boolean).forEach((e) => {\n    if (!semRepetir.some((x) => x.toLowerCase() === e.toLowerCase())) semRepetir.push(e);\n  });\n  const principal = semRepetir[0] || \"\";\n  const adicionais = semRepetir.slice(1).join(\",\");\n\n  const p = { name: texto(razaoSocial), cpfCnpj: soDigitos(documento) };\n  if (principal) p.email = principal;\n  if (adicionais) p.additionalEmails = adicionais;\n  if (celular) p.mobilePhone = celular;\n  if (end.address) p.address = end.address;\n  if (end.addressNumber) p.addressNumber = end.addressNumber;\n  if (end.complement) p.complement = end.complement;\n  if (end.postalCode) p.postalCode = end.postalCode;\n  if (provincia) p.province = provincia;\n  return p;\n}\n\nconst corpo = $(\"Recebe pedido do app\").first().json.body || {};\nconst dados = $(\"Prepara dados\").first().json;\nconst entidadeId = $(\"Cria no Airtable\").first().json.id;\n\nlet locais = [];\ntry { locais = JSON.parse(corpo.locais || \"[]\"); } catch (e) { locais = []; }\nif (!Array.isArray(locais)) locais = [];\nconst local0 = locais[0] || {};\n\nlet contatos = [];\ntry { contatos = JSON.parse(corpo.contatos || \"[]\"); } catch (e) { contatos = []; }\nif (!Array.isArray(contatos)) contatos = [];\nconst contato0 = contatos[0] || {};\nconst emailsContato = Array.isArray(contato0.emails) ? contato0.emails : [];\nconst whatsappContato = Array.isArray(contato0.whatsapps) ? (contato0.whatsapps[0] || \"\") : \"\";\n\nconst payload = montaPayload({\n  razaoSocial: dados.razaoSocial, documento: dados.documento, emailNfe: dados.emails,\n  emailsContato, whatsappContato,\n  enderecoCompleto: local0.endereco, bairroCidade: local0.bairroCidade,\n});\n// So na criacao a notificacao comeca desligada. Depois disso o sync nunca\n// mais manda essa chave, entao se o dono ligar direto na Asaas, fica ligada.\npayload.notificationDisabled = true;\npayload.externalReference = entidadeId;\n\nreturn [{ json: { payload, entidadeId } }];"
      },
