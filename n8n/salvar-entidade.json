    {
      "parameters": {
        "jsCode": "// Transforma a lista de enderecos que veio do app em um item por endereco,\n// cada um ja apontando para o cliente recem-criado.\nconst corpo = $('Recebe pedido do app').first().json.body || {};\nconst entidadeId = $('Cria no Airtable').first().json.id;\n\nlet recebidos = [];\ntry {\n  recebidos = JSON.parse(corpo.locais || '[]');\n} catch (erro) {\n  // App antigo (sem o campo) ou texto quebrado: segue sem endereco nenhum,\n  // que e melhor do que perder o cadastro inteiro.\n  recebidos = [];\n}\nif (!Array.isArray(recebidos)) recebidos = [];\n\nconst texto = (v) => String(v ?? '').trim();\nconst limpos = recebidos\n  .map((l) => ({\n    nome: texto(l.nome),\n    endereco: texto(l.endereco),\n    bairroCidade: texto(l.bairroCidade),\n    acesso: texto(l.acesso),\n  }))\n  .filter((l) => l.nome || l.endereco || l.bairroCidade || l.acesso);\n\n// Sem endereco nenhum ainda precisa sair um item, senao o fluxo morre aqui\n// e o app fica esperando uma resposta que nunca chega.\nif (limpos.length === 0) return [{ json: { temLocal: false } }];\n\nreturn limpos.map((l) => ({\n  json: {\n    temLocal: true,\n    entidadeId,\n    // Nome_do_Local e o campo principal da tabela: em branco, o registro\n    // aparece sem titulo na lista do Airtable.\n    nome: l.nome || l.endereco || 'Local sem nome',\n    endereco: l.endereco,\n    bairroCidade: l.bairroCidade,\n    acesso: l.acesso,\n  },\n}));"
      },
