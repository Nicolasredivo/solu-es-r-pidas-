    {
      "parameters": {
        "jsCode": "// Transforma a lista de contatos do app em um item por contato, cada um\n// ja apontando para o cliente recem-criado.\nconst corpo = $('Recebe pedido do app').first().json.body || {};\nconst entidadeId = $('Cria no Airtable').first().json.id;\n\nlet recebidos = [];\ntry {\n  recebidos = JSON.parse(corpo.contatos || '[]');\n} catch (erro) {\n  // App antigo (sem o campo) ou texto quebrado: segue sem contato nenhum.\n  recebidos = [];\n}\nif (!Array.isArray(recebidos)) recebidos = [];\n\nconst texto = (v) => String(v ?? '').trim();\nconst lista = (v) => (Array.isArray(v) ? v.map(texto).filter(Boolean) : []);\n\nconst limpos = recebidos\n  .map((c) => ({\n    nome: texto(c.nome),\n    cargo: texto(c.cargo),\n    whatsapps: lista(c.whatsapps),\n    emails: lista(c.emails),\n    observacoes: texto(c.observacoes),\n    status: texto(c.status) || 'Ativo',\n  }))\n  .filter((c) => c.nome || c.whatsapps.length || c.emails.length || c.observacoes);\n\n// Sem contato nenhum ainda precisa sair um item, senao o fluxo morre aqui\n// e o app fica esperando uma resposta que nunca chega.\nif (limpos.length === 0) return [{ json: { temContato: false } }];\n\nreturn limpos.map((c) => ({\n  json: {\n    temContato: true,\n    entidadeId,\n    // Nome_Contato e o campo principal: em branco, o registro aparece sem\n    // titulo na lista do Airtable.\n    nome: c.nome || c.whatsapps[0] || c.emails[0] || 'Contato sem nome',\n    // Lista de escolha recusa texto vazio; null e 'em branco' para o Airtable.\n    cargo: c.cargo || null,\n    // Um valor por linha: e assim que o campo guarda varios sem criar coluna.\n    whatsapps: c.whatsapps.join('\\n'),\n    emails: c.emails.join('\\n'),\n    observacoes: c.observacoes,\n    status: c.status,\n  },\n}));"
      },
