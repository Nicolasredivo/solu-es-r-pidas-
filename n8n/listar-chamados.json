    {
      "parameters": {
        "jsCode": "const achados = $input.all().map((i) => i.json).filter((j) => j && j.id && !j.error);\n\nconst chamados = achados.map((j) => {\n  const f = j.fields || {};\n  return {\n    id: j.id,\n    numero: f.Numero_Chamado || \"\",\n    status: f.Status || \"\",\n    clienteId: (f.Cliente_Ref || [])[0] || \"\",\n    clienteNome: f.Cliente_Nome || \"\",\n    clienteDocumento: f.Cliente_Documento || \"\",\n    enderecoCopia: f.Endereco_Copia || \"\",\n    localExato: f.Local_Exato || \"\",\n    descricaoSolicitacao: f.Descricao_Solicitacao || \"\",\n    observacoesServico: f.Observacoes_Servico || \"\",\n    contatoNome: f.Contato_Nome || \"\",\n    contatoWhatsApp: f.Contato_WhatsApp || \"\",\n    horarioCombinadoCliente: f.Horario_Combinado_Cliente || \"\",\n    reservadoInicio: f.Reservado_Inicio || \"\",\n    reservadoFim: f.Reservado_Fim || \"\",\n    duracaoEscolhida: f.Duracao_Escolhida || \"\",\n    anexos: (f.Anexos || []).map((a) => ({ filename: a.filename, url: a.url })),\n    // Data/hora de criacao do registro -- o Airtable ja guarda isso\n    // sozinho em toda linha (createdTime), sem precisar de campo novo.\n    // Usado pra mostrar no card e pra ordenar do mais antigo pro mais\n    // recente (ver CONTEXTO.md 'Data de criacao no card', 14/09/2026).\n    criadoEm: j.createdTime || \"\",\n  };\n});\n\nconst semData = chamados.filter((c) => !c.reservadoInicio)\n  .sort((a, b) => new Date(a.criadoEm) - new Date(b.criadoEm));\nconst comData = chamados.filter((c) => c.reservadoInicio)\n  .sort((a, b) => new Date(a.reservadoInicio) - new Date(b.reservadoInicio));\n\nreturn [{ json: { ok: true, semData, comData } }];"
      },
