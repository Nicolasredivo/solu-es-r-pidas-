    {
      "id": "9c12efdd-471f-405e-91d3-424d2c3dd2a6",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -200
      ],
      "parameters": {
        "jsCode": "const e = $('Le entrada').first().json;\nconst sindicaturasBrutas = $('Busca sindicaturas').all().map((i) => i.json);\nconst contatosBrutos = $('Busca contatos').all().map((i) => i.json);\nconst recusa = (mensagem) => [{ json: { gravar: false, resposta: { ok: false, mensagem } } }];\n\n// Banco fora do ar não pode parecer \"nenhuma sindicatura\".\nif (sindicaturasBrutas.some((j) => j && j.error) || contatosBrutos.some((j) => j && j.error)) {\n  return recusa('Não foi possível falar com o banco agora. Tente de novo em instantes.');\n}\n\n// \"Síndicos Exemplo\" e \"SINDICOS EXEMPLO.\" são a mesma: igual ao normalizarTexto do app.\nconst chave = (t) => String(t || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();\nconst QUEBRA = String.fromCharCode(10);\nconst porLinha = (t) => String(t || '').split(QUEBRA).map((v) => v.trim()).filter(Boolean);\nconst sindicaturas = sindicaturasBrutas.filter((j) => j && j.id)\n  .map((j) => ({ id: j.id, nome: (j.fields && j.fields.Nome) || '' }));\n\nif (e.acao === 'listar') {\n  // Quem trabalha nela: os contatos com o mesmo nome no campo Empresas.\n  const contatos = contatosBrutos.filter((j) => j && j.id).map((j) => {\n    const f = j.fields || {};\n    return { id: j.id, nome: f.Nome_Contato || '', funcao: f.Cargo_Funcao || '', chaves: porLinha(f.Empresas).map(chave) };\n  });\n  const lista = sindicaturas.map((s) => ({\n    ...s,\n    contatos: contatos.filter((c) => c.chaves.includes(chave(s.nome)))\n      .map((c) => ({ id: c.id, nome: c.nome, funcao: c.funcao }))\n      .sort((a, b) => (a.nome || '~').localeCompare(b.nome || '~', 'pt-BR')),\n  })).sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR', { sensitivity: 'base' }));\n  return [{ json: { gravar: false, resposta: { ok: true, sindicaturas: lista } } }];\n}\n\n// salvar: só o nome, e nunca duas com o mesmo nome.\nif (!chave(e.nome)) return recusa('Escreva o nome da sindicatura.');\nconst igual = sindicaturas.find((s) => chave(s.nome) === chave(e.nome));\nif (igual) return [{ json: { gravar: false, resposta: { ok: false, jaExiste: true, mensagem: 'Já existe a sindicatura \"' + igual.nome + '\".', sindicatura: igual } } }];\nreturn [{ json: { gravar: true, acao: 'salvar', metodo: 'POST', url: 'http://127.0.0.1:5690/v0/app6PyYmtFduIMp7B/tblSindicatura001', corpo: { records: [{ fields: { Nome: e.nome } }] } } }];"
      }
