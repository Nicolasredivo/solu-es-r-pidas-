    {
      "id": "7ab1ba0d-b81a-4ff7-9172-923d233d460d",
      "name": "Le entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "jsCode": "// Tudo chega como texto (o app manda formulário simples).\nconst corpo = $('Recebe pedido do app').first().json.body || {};\nconst texto = (v) => String(v ?? '').trim();\nconst ACOES = ['listar', 'salvar'];\nconst acao = ACOES.includes(texto(corpo.acao)) ? texto(corpo.acao) : '';\nconst nome = texto(corpo.nome).replace(/\\s+/g, ' ').slice(0, 120);\nlet erro = '';\nif (!acao) erro = 'Ação inválida.';\nelse if (acao === 'salvar' && !nome) erro = 'Escreva o nome da sindicatura.';\nreturn [{ json: { acao, nome, erro } }];"
      }
    },
