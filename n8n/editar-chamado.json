    {
      "parameters": {
        "jsCode": "const achado = $(\"Busca chamado atual\").all().map((i) => i.json).find((j) => j && j.id && !j.error);\nif (!achado) return [{ json: { erro: \"Chamado nao encontrado.\" } }];\nconst f = achado.fields || {};\nconst b = $(\"Recebe pedido do app\").first().json.body || {};\nconst texto = (v) => String(v ?? \"\").trim();\n\nconst fields = {\n  Local_Exato: texto(b.localExato),\n  Descricao_Solicitacao: texto(b.descricaoSolicitacao),\n  Observacoes_Servico: texto(b.observacoesServico),\n};\n\nconst entrada = $input.first().json || {};\n\nconst contatoNovo = entrada.contatoNovo;\nif (contatoNovo && contatoNovo.id && !contatoNovo.error) {\n  const cf = contatoNovo.fields || {};\n  const linhas = (v) => (Array.isArray(v) ? v : String(v || \"\").split(\"\\n\")).map((s) => s.trim()).filter(Boolean);\n  fields.Contato_Nome = cf.Nome_Contato || \"\";\n  fields.Contato_WhatsApp = linhas(cf.WhatsApps)[0] || \"\";\n  fields.Contato_Email = linhas(cf.Emails)[0] || \"\";\n}\n\n// Endereco escolhido pelo app quando o cliente tem mais de um endereco\n// cadastrado (ver CONTEXTO.md 'Selecao de endereco', 14/09/2026).\nconst localNovo = entrada.localNovo;\nif (localNovo && localNovo.id && !localNovo.error) {\n  const lf = localNovo.fields || {};\n  fields.Endereco_Copia = lf.Endereco_Completo || \"\";\n}\n\nconst agora = new Date().toISOString();\nconst linha = agora + \" -- Chamado editado.\";\nfields.Historico = (f.Historico ? f.Historico + \"\\n\" : \"\") + linha;\n\nreturn [{ json: { chamadoId: achado.id, metodo: \"PATCH\", url: \"https://api.airtable.com/v0/app6PyYmtFduIMp7B/tbltipxOIw8F96QHO\", corpo: { typecast: true, records: [{ id: achado.id, fields }] } } }];"
      },
