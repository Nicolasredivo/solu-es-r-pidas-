    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst texto = (v) => String(v == null ? \"\" : v).trim();\nconst lista = (v) => texto(v) || null;\nconst numero = (v) => {\n  const n = Number(String(v == null ? \"\" : v).replace(\",\", \".\"));\n  return Number.isFinite(n) ? n : 0;\n};\nconst ehRegistro = (v) => /^rec[A-Za-z0-9]{14}$/.test(texto(v));\n// [^0-9] em vez do atalho com barra invertida: escapar barra dentro de tanta\n// camada de texto ja quebrou este arquivo uma vez.\nconst soDigitos = (v) => texto(v).replace(/[^0-9]/g, \"\");\n\n// A tabela tem uma linha so. O app manda o id que leu; sem id, cria.\nconst id = texto(b.id);\nconst fields = {\n  Chave: \"principal\",\n  Saldo_Inicial: numero(b.saldoInicial),\n  Data_Saldo_Inicial: lista(b.dataSaldoInicial),\n  Reserva_Meta: numero(b.reservaMeta),\n  Giro_Meta: numero(b.giroMeta),\n  Regime: lista(b.regime) || \"MEI\",\n  Imposto_Fixo_Mensal: numero(b.impostoFixoMensal),\n  // O Airtable guarda porcentagem como fracao: 6% vira 0,06.\n  Aliquota_Imposto: numero(b.aliquotaImposto) / 100,\n  Teto_Anual: numero(b.tetoAnual),\n  Folha_Mensal: numero(b.folhaMensal),\n  Provisiona_Decimo_Ferias: texto(b.provisionaDecimoFerias) === \"sim\",\n  Socio_1_Nome: texto(b.socio1Nome),\n  Socio_2_Nome: texto(b.socio2Nome),\n  Socio_1_Percentual: numero(b.socio1Percentual) / 100,\n  Socio_2_Percentual: numero(b.socio2Percentual) / 100,\n};\n\nreturn [{\n  json: {\n    invalido: false,\n    metodo: ehRegistro(id) ? \"PATCH\" : \"POST\",\n    url: \"https://api.airtable.com/v0/appjAmWXV7Zr33UqE/tbl3uT9h7ZYXnfR7E\",\n    corpo: { typecast: true, records: [ehRegistro(id) ? { id, fields } : { fields }] },\n  },\n}];"
      },
