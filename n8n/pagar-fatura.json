    {
      "parameters": {
        "jsCode": "const resposta = $json || {};\nconst dados = $(\"Tem saldo?\").first().json;\nconst hoje = new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);\n\nconst chamadas = [];\n\n// O comprovante vem primeiro de proposito: se a gravacao seguinte falhar,\n// o pior caso e ter o registro do dinheiro que saiu, nunca o contrario.\nchamadas.push({\n  metodo: \"POST\",\n  url: \"https://api.airtable.com/v0/appjAmWXV7Zr33UqE/tbldfftPos0qX7nlm\",\n  corpo: { typecast: true, records: [{ fields: {\n    Data: hoje,\n    Cartao_Ref: [dados.cartaoId],\n    Vencimento_Fatura: dados.vencimento || null,\n    Valor: dados.valor,\n    Valor_Calculado: dados.valorCalculado,\n    Status: \"Enviado\",\n    Asaas_Transfer_Id: String(resposta.id || \"\"),\n  } }] },\n});\n\n// As despesas da fatura viram pagas: e isto que tira o dinheiro do caixa.\n// O PIX em si nao vira despesa, senao o mesmo real contaria duas vezes.\nfor (let i = 0; i < dados.ids.length; i += 10) {\n  chamadas.push({\n    metodo: \"PATCH\",\n    url: \"https://api.airtable.com/v0/appjAmWXV7Zr33UqE/tblNduEKl2jY280V0\",\n    corpo: { typecast: true, records: dados.ids.slice(i, i + 10).map((id) => ({\n      id, fields: { Status: \"Pago\", Data_Pagamento: hoje },\n    })) },\n  });\n}\n\n// Pagou diferente do que o sistema somou? A diferenca vira uma despesa\n// propria, senao o caixa ficaria errado pelo tamanho da diferenca.\nconst diferenca = Math.round((dados.valor - dados.valorCalculado) * 100) / 100;\nif (Math.abs(diferenca) >= 0.01) {\n  chamadas.push({\n    metodo: \"POST\",\n    url: \"https://api.airtable.com/v0/appjAmWXV7Zr33UqE/tblNduEKl2jY280V0\",\n    corpo: { typecast: true, records: [{ fields: {\n      Descricao: \"Diferença da fatura \" + dados.nomeCartao,\n      Valor: diferenca,\n      Vencimento: dados.vencimento || hoje,\n      Data_Pagamento: hoje,\n      Status: \"Pago\",\n      Categoria: \"Outros\",\n      Forma_Pagamento: \"PIX\",\n      Cartao_Ref: [dados.cartaoId],\n      Observacoes: \"Lançada sozinha: a fatura foi paga por um valor diferente do que o sistema tinha somado.\",\n    } }] },\n  });\n}\n\nreturn chamadas.map((c) => ({ json: c }));"
      },
