    {
      "parameters": {
        "jsCode": "const cartao = $input.all().filter((i) => i.json && i.json.id && !i.json.error)[0];\nconst b = $(\"Recebe pedido do app\").first().json.body || {};\n\nconst numero = (v) => {\n  const n = Number(String(v == null ? \"\" : v).replace(\",\", \".\"));\n  return Number.isFinite(n) ? n : 0;\n};\n\nif (!cartao) {\n  return [{ json: { erro: \"Cartão não encontrado.\" } }];\n}\n\nconst f = cartao.json.fields || {};\n// A chave vem SEMPRE do cadastro. O app manda so quanto e de qual cartao.\nconst chave = String(f.Chave_PIX || \"\").trim();\nconst tipo = String(f.Tipo_Chave_PIX || \"\").trim();\n\nif (!chave || !tipo) {\n  return [{ json: { erro: \"Este cartão não tem chave PIX cadastrada. Preencha em Cartões antes de pagar.\" } }];\n}\n\nconst valor = Math.round(numero(b.valor) * 100) / 100;\nif (valor < 0.01) {\n  return [{ json: { erro: \"Informe um valor de pelo menos R$ 0,01.\" } }];\n}\n\n// Trava de bom senso contra dedo errado: valor absurdo nao passa calado.\nif (valor > 100000) {\n  return [{ json: { erro: \"Valor acima de R$ 100.000. Por segurança, pague esse valor direto no banco.\" } }];\n}\n\nconst vencimento = String(b.vencimentoFatura || \"\").slice(0, 10);\nconst ids = String(b.ids || \"\").split(\",\").map((x) => x.trim())\n  .filter((x) => /^rec[A-Za-z0-9]{14}$/.test(x));\n\nreturn [{ json: {\n  erro: \"\",\n  valor,\n  valorCalculado: Math.round(numero(b.valorCalculado) * 100) / 100,\n  chave, tipo, vencimento, ids,\n  cartaoId: cartao.json.id,\n  nomeCartao: f.Nome || \"cartão\",\n} }];"
      },
