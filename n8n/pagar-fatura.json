        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ value: $json.valor, pixAddressKey: $json.chave, pixAddressKeyType: $json.tipo, description: \"Fatura \" + $json.nomeCartao + \" venc \" + $json.vencimento, externalReference: \"fatura-\" + $json.cartaoId + \"-\" + $json.vencimento }) }}",
        "options": {
