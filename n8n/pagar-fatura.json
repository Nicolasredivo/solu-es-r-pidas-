    {
      "parameters": {
        "jsCode": "const achados = $input.all().filter((i) => i.json && i.json.id && !i.json.error);\nconst pedido = $(\"Recebe pedido do app\").first().json.body || {};\nconst cartaoId = String(pedido.cartaoId || \"\").trim();\nconst vencimento = String(pedido.vencimentoFatura || \"\").slice(0, 10);\n\n// O casamento e feito aqui, e nao na busca: no Code node o Cartao_Ref\n// chega como lista de codigos de verdade, que e o que precisamos comparar.\nconst jaPago = achados.some((i) => {\n  const f = i.json.fields || {};\n  const mesmoCartao = (f.Cartao_Ref || []).includes(cartaoId);\n  const mesmaFatura = String(f.Vencimento_Fatura || \"\").slice(0, 10) === vencimento;\n  return mesmoCartao && mesmaFatura;\n});\n\nreturn [{ json: {\n  jaPago,\n  cartaoId,\n  vencimentoFatura: vencimento,\n} }];"
      },
