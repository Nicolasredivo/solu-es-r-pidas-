    },
    {
      "parameters": {
        "jsCode": "const saldo = Number(($json || {}).balance);\nconst dados = $(\"Monta o PIX\").first().json;\n\n// Se a consulta falhou, nao inventa: melhor recusar do que mandar as cegas.\nif (!Number.isFinite(saldo)) {\n  return [{ json: { ...dados, semSaldo: true,\n    mensagemSaldo: \"Não consegui conferir o saldo do Asaas. Nenhum PIX foi enviado.\" } }];\n}\n\nif (saldo < dados.valor) {\n  const falta = (dados.valor - saldo).toFixed(2).replace(\".\", \",\");\n  const tem = saldo.toFixed(2).replace(\".\", \",\");\n  return [{ json: { ...dados, semSaldo: true, saldo,\n    mensagemSaldo: \"Saldo no Asaas é de R$ \" + tem + \", faltam R$ \" + falta + \". Nenhum PIX foi enviado.\" } }];\n}\n\nreturn [{ json: { ...dados, semSaldo: false, saldo } }];"
      },
