    {
      "parameters": {
        "jsCode": "// O PIX nao saiu. Guarda a tentativa para o dono saber o que aconteceu.\nconst erro = $json || {};\nconst dados = $(\"Tem saldo?\").first().json;\nconst hoje = new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);\n\nconst motivo = ((erro.error || {}).message)\n  || (((erro.errors || [])[0] || {}).description)\n  || \"O Asaas recusou a transferência.\";\n\nreturn [{ json: {\n  metodo: \"POST\",\n  url: \"https://api.airtable.com/v0/appjAmWXV7Zr33UqE/tbldfftPos0qX7nlm\",\n  corpo: { typecast: true, records: [{ fields: {\n    Data: hoje,\n    Cartao_Ref: [dados.cartaoId],\n    Vencimento_Fatura: dados.vencimento || null,\n    Valor: dados.valor,\n    Valor_Calculado: dados.valorCalculado,\n    Status: \"Falhou\",\n    Observacoes: motivo,\n  } }] },\n  motivo,\n} }];"
