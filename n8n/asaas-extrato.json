    {
      "id": "ef2986b0-90e1-4d40-8ff6-ff982879f82a",
      "name": "Junta as contas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "jsCode": "// Junta as páginas das duas contas numa lista só. Uma conta que não respondeu fica de fora (e vai em \"erros\").\nconst CONTAS = [['CNPJ 1', 'Extrato CNPJ 1'], ['CNPJ 2', 'Extrato CNPJ 2']];\nconst itens = [], erros = [], vistos = new Set();\nlet incompleto = false;\nfor (const [conta, no] of CONTAS) {\n  let pags = [];\n  try { pags = $(no).all().map((i) => i.json || {}); } catch (e) { erros.push(conta); continue; }\n  if (!pags.length || pags.some((p) => p.error || (Array.isArray(p.errors) && p.errors.length) || !Array.isArray(p.data))) { erros.push(conta); continue; }\n  if (pags[pags.length - 1].hasMore === true) incompleto = true;\n  pags.forEach((p, pi) => p.data.forEach((tx, i) => {\n    if (!tx || !tx.id) return;\n    const chave = conta + ':' + tx.id;\n    if (vistos.has(chave)) return;\n    vistos.add(chave);\n    itens.push({\n      id: tx.id, conta, data: String(tx.date || '').slice(0, 10), tipo: String(tx.type || ''),\n      descricao: String(tx.description || '').replace(/\\s+/g, ' ').trim().slice(0, 300),\n      paymentId: String(tx.paymentId || ''), centavos: Math.round(Number(tx.value || 0) * 100), ordem: pi * 100000 + i,\n    });\n  }));\n}\nconst pays = [...new Set(itens.map((x) => x.paymentId).filter(Boolean))];\nconst conc = [...pays.map((p) => 'pay:' + p), ...itens.filter((x) => !x.paymentId).map((x) => 'ft:' + x.id)];\nconst e = $('Le entrada').first().json;\nreturn [{ json: { inicio: e.inicio, fim: e.fim, itens, erros, incompleto, busca: { pays, conc, obs: itens.map((x) => x.conta + ':' + x.id) } } }];"
      }
    },
    {
      "id": "d722953e-9717-44a6-9010-7b7bb19d07ba",
      "name": "Nomes no banco",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1760,
        300
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "parameters": {
        "operation": "executeQuery",
        "query": "with e as (select $1::jsonb as j)\nselect jsonb_build_object(\n  'pay', coalesce((select jsonb_object_agg(r.\"Asaas_Cobranca_Id\", r.\"Cliente_Nome\")\n      from \"Recebimentos\" r, e\n     where r.\"Asaas_Cobranca_Id\" in (select jsonb_array_elements_text(e.j -> 'pays'))\n       and coalesce(btrim(r.\"Cliente_Nome\"), '') <> ''), '{}'::jsonb),\n  'conc', coalesce((select jsonb_object_agg(c.\"Transacao_Id\", coalesce(nullif(btrim(rr.\"Cliente_Nome\"), ''), nullif(btrim(c.\"Pagador\"), '')))\n      from \"Conciliacao\" c left join \"Recebimentos\" rr on rr.id = c.\"Recebimento_Ref\", e\n     where c.\"Transacao_Id\" in (select jsonb_array_elements_text(e.j -> 'conc'))\n       and coalesce(nullif(btrim(rr.\"Cliente_Nome\"), ''), nullif(btrim(c.\"Pagador\"), '')) is not null), '{}'::jsonb),\n  -- Observação do dono em cada movimentação (28/11/2026).\n  'obs', coalesce((select jsonb_object_agg(o.id, o.\"Texto\") from \"Extrato_Observacoes\" o, e\n     where o.id in (select jsonb_array_elements_text(e.j -> 'obs'))), '{}'::jsonb)\n) as r",
        "options": {
          "queryReplacement": "={{ [ $json.busca ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "TkRgR5fLjBCec0VE",
          "name": "Banco local - n8n_app (cobrancas)"
        }
      }
    },
    {
      "id": "f27d8c21-03d5-47c2-aa4c-aa01b70c5d12",
      "name": "Monta resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "jsCode": "// Nome do cliente: da cobrança do sistema (Recebimentos) ou da entrada já conhecida (Conciliacao). Sem chamar o Asaas de novo.\nconst base = $('Junta as contas').first().json;\nconst n = ($input.first().json || {}).r || {};\nconst pay = n.pay || {}, conc = n.conc || {}, obs = n.obs || {};\nif (base.erros.length === 2) return [{ json: { resposta: { ok: false, mensagem: 'Não consegui ler o extrato do Asaas agora. Tente de novo daqui a pouco.' } } }];\nconst itens = base.itens\n  .map((x) => ({ ...x, cliente: (x.paymentId && (pay[x.paymentId] || conc['pay:' + x.paymentId])) || conc['ft:' + x.id] || '' }))\n  .sort((a, b) => (a.data < b.data ? 1 : a.data > b.data ? -1 : a.conta === b.conta ? b.ordem - a.ordem : a.conta < b.conta ? -1 : 1));\nlet entrou = 0, saiu = 0;\nfor (const x of itens) { if (x.centavos > 0) entrou += x.centavos; else saiu -= x.centavos; }\nreturn [{ json: { resposta: {\n  ok: true, inicio: base.inicio, fim: base.fim, erros: base.erros, incompleto: base.incompleto,\n  totais: { entrou: entrou / 100, saiu: saiu / 100, saldo: (entrou - saiu) / 100, quantidade: itens.length },\n  itens: itens.map((x) => ({ id: x.id, conta: x.conta, data: x.data, descricao: x.descricao, cliente: x.cliente, tipo: x.tipo, valor: x.centavos / 100, obs: obs[x.conta + ':' + x.id] || '' })),\n} } }];"
      }
    },
    {
      "id": "fa41c3f1-37c4-49c1-8981-91caebe4ce06",
      "name": "Responde extrato",
