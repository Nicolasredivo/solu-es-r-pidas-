    {
      "id": "95d3fb06-bf00-4234-996c-543b262094e6",
      "name": "Le entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Período do extrato: inicio e fim (AAAA-MM-DD). Vazio = últimos 30 dias (hoje entra), no horário de Brasília.\nconst b = $('Recebe pedido do app').first().json.body || {};\nconst t = (v) => String(v ?? '').trim();\nconst hoje = new Date(Date.now() - 3 * 3600 * 1000).toISOString().slice(0, 10);\nconst menos = (iso, n) => new Date(Date.parse(iso + 'T12:00:00Z') - n * 86400000).toISOString().slice(0, 10);\nconst valida = (s) => /^\\d{4}-\\d{2}-\\d{2}$/.test(s) && !isNaN(Date.parse(s + 'T12:00:00Z')) && new Date(Date.parse(s + 'T12:00:00Z')).toISOString().slice(0, 10) === s;\nlet inicio = t(b.inicio), fim = t(b.fim), erro = '';\nif (!inicio && !fim) { fim = hoje; inicio = menos(hoje, 29); }\nelse if (!valida(inicio) || !valida(fim)) erro = 'Confira as datas.';\nelse if (inicio > fim) erro = 'A data de início vem depois da data de fim.';\nelse if (inicio < '2000-01-01') erro = 'Confira a data de início.';\nreturn [{ json: { ok: !erro, erro, inicio, fim } }];"
      }
    },
