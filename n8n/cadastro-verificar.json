    {
      "parameters": {
        "resource": "record",
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "app6PyYmtFduIMp7B",
          "mode": "list",
          "cachedResultName": "cadastro"
        },
        "table": {
          "__rl": true,
          "value": "tblucYjrD3SKf1azh",
