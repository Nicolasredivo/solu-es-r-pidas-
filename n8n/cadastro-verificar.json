        "jsCode": "const entrada = $input.first().json;\nconst baseId = 'app6PyYmtFduIMp7B';\nconst tableId = 'tblucYjrD3SKf1azh';\n\nreturn [{\n  json: {\n    metodo: 'PATCH',\n    url: 'https://api.airtable.com/v0/' + baseId + '/' + tableId + '/' + entrada.usuarioId,\n    corpo: {\n      fields: {\n        Codigo_Tentativas: (entrada.tentativasAtuais || 0) + 1\n      }\n    }\n  }\n}];\n"
