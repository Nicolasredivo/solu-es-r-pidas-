    {
      "parameters": {
        "jsCode": "// Le os IDs dos locais ligados direto do campo reciproco da entidade\n// (Entidades_Cadastradas.Locais_Atendimento) -- nao depende do CPF/CNPJ,\n// entao funciona igual pra cadastro com ou sem documento (ver Cadastro so\n// com nome, CONTEXTO.md 14/09/2026).\nconst entidade = $input.first().json;\nif (!entidade || !entidade.id) return [{ json: { formula: 'FALSE()' } }];\nconst raw = (entidade.fields && entidade.fields.Locais_Atendimento) || [];\nconst ids = raw.map((v) => (typeof v === 'string' ? v : (v && v.id) || '')).filter(Boolean);\nconst formula = ids.length\n  ? 'OR(' + ids.map((id) => \"RECORD_ID()='\" + id + \"'\").join(',') + ')'\n  : 'FALSE()';\nreturn [{ json: { formula } }];"
      },
