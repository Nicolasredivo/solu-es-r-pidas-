        "filterByFormula": "={{ (() => { const id = String($json.body.entidadeId || '').replace(/[^a-zA-Z0-9]/g, ''); if (id) return \"RECORD_ID() = '\" + id + \"'\"; const doc = String($json.body.documento || '').replace(/\\D/g, ''); return doc ? \"{CPF_CNPJ} = '\" + doc + \"'\" : 'FALSE()'; })() }}",
