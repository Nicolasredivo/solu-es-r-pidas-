    {
      "parameters": {
        "jsCode": "const achados = $input.all().filter((i) => i.json && i.json.id && !i.json.error);\n\nconst locais = achados.map((i) => {\n  const c = i.json.fields || {};\n  return {\n    id: i.json.id,\n    nome: c.Nome_do_Local || \"\",\n    endereco: c.Endereco_Completo || \"\",\n    bairroCidade: c.Bairro_Cidade || \"\",\n    acesso: c.Observacoes_Acesso || \"\",\n    status: c.Status || \"\",\n  };\n});\n\nreturn [{ json: { ok: true, locais } }];"
      },
