    {
      "parameters": {
        "jsCode": "const uteis = (nome) => $(nome).all().filter((i) => i.json && i.json.id && !i.json.error);\n\nconst achado = uteis('Busca cadastro')[0];\nif (!achado) return [{ json: { ok: false, mensagem: 'Cadastro nao encontrado.' } }];\nconst f = achado.json.fields || {};\n\nconst porLinha = (texto) => String(texto || '').split('\\n').map((v) => v.trim()).filter(Boolean);\n\nconst locais = uteis('Busca locais').map((i) => {\n  const c = i.json.fields || {};\n  return {\n    id: i.json.id,\n    nome: c.Nome_do_Local || '',\n    endereco: c.Endereco_Completo || '',\n    bairroCidade: c.Bairro_Cidade || '',\n    acesso: c.Observacoes_Acesso || '',\n    status: c.Status || '',\n  };\n});\n\nconst contatos = uteis('Busca contatos').map((i) => {\n  const c = i.json.fields || {};\n  return {\n    id: i.json.id,\n    nome: c.Nome_Contato || '',\n    cargo: c.Cargo_Funcao || '',\n    whatsapps: porLinha(c.WhatsApps),\n    emails: porLinha(c.Emails),\n    observacoes: c.Observacoes || '',\n    status: c.Status || '',\n  };\n});\n\nreturn [{\n  json: {\n    ok: true,\n    cadastro: {\n      id: achado.json.id,\n      documento: f.CPF_CNPJ || '',\n      razaoSocial: f.Razao_Social_Nome || '',\n      nomeFantasia: f.Nome_Fantasia_Identificador || '',\n      tipo: f.Tipo_Documento || '',\n      exigenciaFiscal: f.Exigencia_Fiscal || '',\n      emails: f.Emails_Financeiro_NFE || '',\n      whatsappCnpj: f.WhatsApp_CNPJ || '',\n      empresaSindicos: f.Empresa_Sindicos || '',\n      administradora: f.Administradora || '',\n      status: f.Status || '',\n      observacoes: f.Observacoes || '',\n    },\n    locais,\n    contatos,\n  },\n}];"
      },
