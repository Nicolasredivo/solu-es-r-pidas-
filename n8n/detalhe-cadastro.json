        "jsCode": "const achado = $input.all().filter((i) => i.json && i.json.id && !i.json.error)[0];\nif (!achado) return [{ json: { ok: false, mensagem: \"Cadastro nao encontrado.\" } }];\n\nconst f = achado.json.fields || {};\nreturn [{\n  json: {\n    ok: true,\n    cadastro: {\n      id: achado.json.id,\n      documento: f.CPF_CNPJ || \"\",\n      razaoSocial: f.Razao_Social_Nome || \"\",\n      nomeFantasia: f.Nome_Fantasia_Identificador || \"\",\n      tipo: f.Tipo_Documento || \"\",\n      exigenciaFiscal: f.Exigencia_Fiscal || \"\",\n      emails: f.Emails_Financeiro_NFE || \"\",\n      whatsappCnpj: f.WhatsApp_CNPJ || \"\",\n      empresaSindicos: f.Empresa_Sindicos || \"\",\n      administradora: f.Administradora || \"\",\n      status: f.Status || \"\",\n      observacoes: f.Observacoes || \"\",\n    },\n  },\n}];"
      },
