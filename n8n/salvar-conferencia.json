        "jsCode": "const b = $json.body || {};\nconst texto = (v) => String(v == null ? \"\" : v).trim();\nconst lista = (v) => texto(v) || null;\nconst numero = (v) => {\n  const n = Number(String(v == null ? \"\" : v).replace(\",\", \".\"));\n  return Number.isFinite(n) ? n : 0;\n};\nconst ehRegistro = (v) => /^rec[A-Za-z0-9]{14}$/.test(texto(v));\n// [^0-9] em vez do atalho com barra invertida: escapar barra dentro de tanta\n// camada de texto ja quebrou este arquivo uma vez.\nconst soDigitos = (v) => texto(v).replace(/[^0-9]/g, \"\");\n\n// A diferenca e calculada aqui, nao no app: assim fica igual venha de onde vier.\nconst informado = numero(b.informado);\nconst calculado = numero(b.calculado);\n\nreturn [{\n  json: {\n    invalido: false,\n    metodo: \"POST\",\n    url: \"https://api.airtable.com/v0/appjAmWXV7Zr33UqE/tblIrMrXYI6FZdKfS\",\n    corpo: {\n      typecast: true,\n      records: [{\n        fields: {\n          Data: lista(b.data),\n          Saldo_Informado: informado,\n          Saldo_Calculado: calculado,\n          Diferenca: Math.round((informado - calculado) * 100) / 100,\n          Observacoes: texto(b.observacoes),\n        },\n      }],\n    },\n  },\n}];"
      },
