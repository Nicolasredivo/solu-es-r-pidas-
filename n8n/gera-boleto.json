      "parameters": {
        "jsCode": "// Chave \"Gera boletos\" do cliente (18/11/2026). Grava só este campo, nada mais do cadastro.\nconst b = $json.body || {};\nconst id = String(b.id || '').trim();\nconst valor = String(b.geraBoleto || '').trim();\nif (!/^rec[A-Za-z0-9]{14}$/.test(id)) return [{ json: { ok: false, mensagem: 'Pedido sem o código do cliente.' } }];\nif (valor !== 'sim' && valor !== 'nao') return [{ json: { ok: false, mensagem: 'Escolha inválida: diga se gera boleto ou não.' } }];\nreturn [{ json: { ok: true, id, gera: valor === 'sim' } }];"
      }
