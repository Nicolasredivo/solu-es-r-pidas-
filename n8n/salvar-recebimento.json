    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst texto = (v) => String(v == null ? \"\" : v).trim();\nconst lista = (v) => texto(v) || null;\nconst numero = (v) => {\n  const n = Number(String(v == null ? \"\" : v).replace(\",\", \".\"));\n  return Number.isFinite(n) ? n : 0;\n};\nconst ehRegistro = (v) => /^rec[A-Za-z0-9]{14}$/.test(texto(v));\n// [^0-9] em vez do atalho com barra invertida: escapar barra dentro de tanta\n// camada de texto ja quebrou este arquivo uma vez.\nconst soDigitos = (v) => texto(v).replace(/[^0-9]/g, \"\");\n\nconst descricao = texto(b.descricao);\nconst valor = numero(b.valor);\nif (!descricao || valor <= 0) {\n  return [{ json: { invalido: true, mensagem: \"Preencha a descrição e um valor válido.\" } }];\n}\n\nconst fields = {\n  Descricao: descricao,\n  Valor: valor,\n  Cliente_Nome: texto(b.cliente),\n  Cliente_Documento: soDigitos(b.clienteDocumento),\n  Vencimento: lista(b.vencimento),\n  Status: lista(b.status) || \"Pendente\",\n  Data_Recebimento: lista(b.dataRecebimento),\n  Forma: lista(b.forma),\n  Observacoes: texto(b.observacoes),\n};\n\nconst id = texto(b.id);\nreturn [{\n  json: {\n    invalido: false,\n    metodo: ehRegistro(id) ? \"PATCH\" : \"POST\",\n    url: \"https://api.airtable.com/v0/appjAmWXV7Zr33UqE/tbl4tMnm3t3peeLYo\",\n    corpo: { typecast: true, records: [ehRegistro(id) ? { id, fields } : { fields }] },\n  },\n}];"
      },
