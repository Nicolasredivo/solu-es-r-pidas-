      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst registros = $input.all();\nconst entrada = $('Monta busca').first().json;\nconst registro = registros[0] && registros[0].json;\n\nif (!registro || !registro.id) {\n  return [{ json: { valido: false, incrementar: false } }];\n}\n\nconst campos = registro.fields || {};\nconst hashGuardado = campos.Codigo_Recuperacao_Hash || '';\nconst expiraEm = campos.Codigo_Expira_Em ? new Date(campos.Codigo_Expira_Em).getTime() : 0;\nconst tentativas = campos.Codigo_Tentativas || 0;\n\nif (!hashGuardado || !expiraEm || expiraEm < Date.now() || tentativas >= 5) {\n  return [{ json: { valido: false, incrementar: false, usuarioId: registro.id } }];\n}\n\nconst hashDigitado = crypto.createHash('sha256').update(entrada.codigo).digest('hex');\nconst bufA = Buffer.from(hashDigitado, 'hex');\nconst bufB = Buffer.from(hashGuardado, 'hex');\nconst bate = bufA.length === bufB.length && crypto.timingSafeEqual(bufA, bufB);\n\nreturn [{\n  json: {\n    valido: bate,\n    incrementar: !bate,\n    usuarioId: registro.id,\n    tentativasAtuais: tentativas\n  }\n}];\n"
      },
