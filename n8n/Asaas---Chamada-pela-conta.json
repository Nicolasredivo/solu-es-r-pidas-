  "nodes": [
    {
      "id": "fcdc74fa-9b63-4924-82db-c7e9acbb744d",
      "name": "Recebe pedido",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "0dd2e2c7-1bd4-44fc-866b-5a6faa264856",
      "name": "Confere pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Só deixa passar chamada para o endereço do Asaas e para uma das duas contas.\nconst BASE = \"https://api.asaas.com/v3/\";\nconst METODOS = ['GET', 'POST', 'PUT', 'DELETE'];\nreturn $input.all().map((i) => {\n  const p = i.json || {};\n  const metodo = String(p.metodo || '').toUpperCase();\n  let rota = 'erro', erro = '';\n  if (p.pular) rota = 'pular';\n  else if (!['CNPJ 1', 'CNPJ 2'].includes(p.conta)) erro = 'conta desconhecida: ' + p.conta;\n  else if (!String(p.url || '').startsWith(BASE)) erro = 'endereço fora do Asaas';\n  else if (!METODOS.includes(metodo)) erro = 'método inválido';\n  else rota = p.conta + ((metodo === 'POST' || metodo === 'PUT') && p.corpo ? ' corpo' : '');\n  return { json: { ...p, metodo, rota, erroPedido: erro } };\n});"
      }
    },
    {
      "id": "babaaaaa-2075-4851-b3ec-6cfe726e2887",
      "name": "Sem chamada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1480,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().map((i) => ({ json: i.json.rota === 'pular' ? { pulado: true } : { error: { message: i.json.erroPedido || 'pedido inválido' } } }));"
      }
    },
