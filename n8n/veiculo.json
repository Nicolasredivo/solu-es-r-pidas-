    {
      "id": "a42fc4f3-3b99-4bf5-a00a-fa3ebf490012",
      "name": "Le entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Tudo chega como texto (o app manda formulário simples).\nconst corpo = $('Recebe pedido do app').first().json.body || {};\nconst texto = (v) => String(v ?? '').trim();\nconst CAMPOS = [\"Placa\",\"Marca_Modelo\",\"Especie_Tipo\",\"Carroceria\",\"Categoria\",\"Cor\",\"Combustivel\",\"Ano_Fabricacao\",\"Ano_Modelo\",\"Renavam\",\"Chassi\",\"Motor\",\"Numero_CRV\",\"Codigo_Seguranca_CLA\",\"CAT\",\"Placa_Anterior\",\"Potencia_Cilindrada\",\"Capacidade\",\"Lotacao\",\"Peso_Bruto_Total\",\"CMT\",\"Eixos\",\"Proprietario_Nome\",\"Proprietario_Documento\",\"Local\",\"Data_Documento\",\"Exercicio\",\"Observacoes\"];\nconst ACOES = ['carregar', 'salvar', 'documento', 'remover-documento'];\nconst acao = ACOES.includes(texto(corpo.acao)) ? texto(corpo.acao) : '';\nlet erro = acao ? '' : 'Ação inválida.';\n\n// Campos: JSON { Campo: \"valor\" }. Só os conhecidos; texto curto.\nlet campos = {};\nif (!erro && (acao === 'salvar' || acao === 'documento')) {\n  let bruto = {};\n  try { bruto = JSON.parse(texto(corpo.campos) || '{}'); } catch (e) { erro = 'Dados do veículo inválidos.'; }\n  if (bruto && typeof bruto === 'object' && !Array.isArray(bruto)) {\n    for (const c of CAMPOS) {\n      if (Object.prototype.hasOwnProperty.call(bruto, c)) {\n        campos[c] = String(bruto[c] ?? '').replace(/\\s+/g, c === 'Observacoes' ? ' ' : ' ').trim().slice(0, c === 'Observacoes' ? 1000 : 200);\n      }\n    }\n  }\n}\n\n// Documento: PDF em base64, até uns 8 MB.\nlet arquivo = '';\nlet nomeArquivo = '';\nif (!erro && acao === 'documento') {\n  arquivo = texto(corpo.arquivo).replace(/^data:[^,]*,/, '');\n  nomeArquivo = texto(corpo.nomeArquivo).replace(/[\\\\/:*?\"<>|\\x00-\\x1f]/g, '_').slice(0, 150) || 'documento-do-veiculo.pdf';\n  if (!/\\.pdf$/i.test(nomeArquivo)) nomeArquivo += '.pdf';\n  if (!arquivo || !/^[A-Za-z0-9+/=]+$/.test(arquivo)) erro = 'Arquivo inválido.';\n  else if (!arquivo.startsWith('JVBERi0')) erro = 'O arquivo precisa ser um PDF.';\n  else if (arquivo.length > 11 * 1024 * 1024) erro = 'O PDF passa de 8 MB. Tente um arquivo menor.';\n}\nreturn [{ json: { acao, campos, arquivo, nomeArquivo, erro } }];\n"
      }
    },
