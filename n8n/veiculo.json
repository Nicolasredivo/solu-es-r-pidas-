    {
      "id": "5ff0a387-6849-4c69-b992-540f4d91f235",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "// Um veículo só, por enquanto: o primeiro (e único) registro da tabela.\nconst e = $('Le entrada').first().json;\nconst registros = ($json.records || []);\nconst atual = registros[0] || null;\nconst URL_TABELA = 'http://127.0.0.1:5690/v0/app6PyYmtFduIMp7B/tblVeiculosFrota1';\nlet grava = false, metodo = '', url = '', corpo = null;\nif (e.acao === 'salvar' || e.acao === 'documento') {\n  const fields = { ...e.campos };\n  // Documento novo substitui o antigo (o arquivo antigo continua na pasta de anexos do PC).\n  if (e.acao === 'documento') fields.Documento = [];\n  grava = true;\n  if (atual) { metodo = 'PATCH'; url = URL_TABELA + '/' + atual.id; corpo = { fields }; }\n  else { metodo = 'POST'; url = URL_TABELA; corpo = { fields }; }\n} else if (e.acao === 'remover-documento' && atual) {\n  grava = true; metodo = 'PATCH'; url = URL_TABELA + '/' + atual.id; corpo = { fields: { Documento: [] } };\n}\nreturn [{ json: { grava, metodo, url, corpo, sobe: e.acao === 'documento' } }];\n"
      }
    },
