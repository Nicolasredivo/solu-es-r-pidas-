    {
      "id": "e50a1b4d-b941-43bb-a6ff-751fe4b309f9",
      "name": "Monta resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        300
      ],
      "parameters": {
        "jsCode": "// Anexo guardado no PC vem com endereço relativo (/webhook/anexo...): completa com o\n// endereço por onde o app chegou (o túnel), senão o PDF não abre no celular.\nconst cab = $('Recebe pedido do app').first().json.headers || {};\nconst origem = String(cab['x-forwarded-proto'] || 'http').split(',')[0].trim() + '://' + (cab['x-forwarded-host'] || cab.host || 'localhost:5678');\nconst urlAnexo = (u) => (String(u || '').startsWith('/') ? origem + u : u);\nconst CAMPOS = [\"Placa\",\"Marca_Modelo\",\"Especie_Tipo\",\"Carroceria\",\"Categoria\",\"Cor\",\"Combustivel\",\"Ano_Fabricacao\",\"Ano_Modelo\",\"Renavam\",\"Chassi\",\"Motor\",\"Numero_CRV\",\"Codigo_Seguranca_CLA\",\"CAT\",\"Placa_Anterior\",\"Potencia_Cilindrada\",\"Capacidade\",\"Lotacao\",\"Peso_Bruto_Total\",\"CMT\",\"Eixos\",\"Proprietario_Nome\",\"Proprietario_Documento\",\"Local\",\"Data_Documento\",\"Exercicio\",\"Observacoes\"];\nconst reg = ($json.records || [])[0] || null;\nlet veiculo = null;\nif (reg) {\n  const f = reg.fields || {};\n  const campos = {};\n  for (const c of CAMPOS) campos[c] = f[c] || '';\n  const doc = (f.Documento || [])[0] || null;\n  veiculo = { id: reg.id, campos, documento: doc ? { nome: doc.filename, url: urlAnexo(doc.url), tamanho: doc.size || 0 } : null };\n}\nconst acao = $('Le entrada').first().json.acao;\nconst MSG = { salvar: 'Salvo.', documento: 'Documento anexado.', 'remover-documento': 'Documento removido.' };\nreturn [{ json: { ok: true, veiculo, mensagem: MSG[acao] || '' } }];\n"
      }
    },
