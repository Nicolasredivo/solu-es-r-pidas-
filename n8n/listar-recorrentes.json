        "jsCode": "const achados = $input.all().filter((i) => i.json && i.json.id && !i.json.error);\nconst primeiro = (v) => (Array.isArray(v) ? (v[0] || \"\") : (v == null ? \"\" : String(v)));\n\nconst recorrentes = achados.map((i) => {\n  const f = i.json.fields || {};\n  return {\n    id: i.json.id,\n    descricao: f.Descricao || \"\",\n    valor: f.Valor || 0,\n    fornecedorId: primeiro(f.Fornecedor_Ref),\n    categoria: f.Categoria || \"\",\n    formaPagamento: f.Forma_Pagamento || \"\",\n    diaDoMes: f.Dia_Do_Mes || 1,\n    restantes: f.Restantes || 0,\n    // O Airtable nao devolve caixinha desmarcada — o campo simplesmente some.\n    // Como quem cria sempre grava Ativo, campo ausente quer dizer desmarcado.\n    semFim: Boolean(f.Sem_Fim),\n    ativo: Boolean(f.Ativo),\n    proximaGeracao: f.Proxima_Geracao || \"\",\n    observacoes: f.Observacoes || \"\",\n  };\n});\n\nreturn [{ json: { ok: true, recorrentes } }];"
