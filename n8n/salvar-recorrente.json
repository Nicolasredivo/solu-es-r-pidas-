      "parameters": {
        "jsCode": "function diaNoMes(ano, mesIndex, dia) {\n  const base = new Date(Date.UTC(ano, mesIndex, 1));\n  const ultimo = new Date(Date.UTC(base.getUTCFullYear(), base.getUTCMonth() + 1, 0)).getUTCDate();\n  const dd = String(Math.min(Math.max(1, dia), ultimo)).padStart(2, \"0\");\n  const mm = String(base.getUTCMonth() + 1).padStart(2, \"0\");\n  return base.getUTCFullYear() + \"-\" + mm + \"-\" + dd;\n}\n\n// Datas em texto (2026-03-15) comparam certo com < e >, sem virar objeto.\nfunction hojeNoBrasil() {\n  return new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);\n}\n\nconst b = $json.body || {};\nconst texto = (v) => String(v ?? \"\").trim();\nconst lista = (v) => texto(v) || null;\nconst numero = (v) => {\n  const n = Number(String(v ?? \"\").replace(\",\", \".\"));\n  return Number.isFinite(n) ? n : null;\n};\n\nconst descricao = texto(b.descricao);\nconst valor = numero(b.valor);\nif (!descricao || valor === null || valor <= 0) {\n  return [{ json: { invalido: true, mensagem: \"Preencha a descrição e um valor válido.\" } }];\n}\n\nconst diaDoMes = Math.min(31, Math.max(1, Number(b.diaDoMes) || 1));\nconst semFim = texto(b.semFim) === \"sim\";\nconst restantes = semFim ? 0 : Math.max(1, Number(b.restantes) || 1);\n\nif (!semFim && !Number(b.restantes)) {\n  return [{ json: { invalido: true, mensagem: \"Diga quantas faltam, ou marque que não tem fim.\" } }];\n}\n\nconst fields = {\n  Descricao: descricao,\n  Valor: valor,\n  Categoria: lista(b.categoria) || \"Outros\",\n  Forma_Pagamento: lista(b.formaPagamento),\n  Dia_Do_Mes: diaDoMes,\n  Restantes: restantes,\n  Sem_Fim: semFim,\n  Ativo: true,\n  Observacoes: texto(b.observacoes),\n};\n\nconst fornecedorId = texto(b.fornecedorId);\nfields.Fornecedor_Ref = /^rec[A-Za-z0-9]{14}$/.test(fornecedorId) ? [fornecedorId] : [];\n\nconst id = texto(b.id);\nconst ehExistente = /^rec[A-Za-z0-9]{14}$/.test(id);\n\n// Na criacao, a primeira cobranca e a proxima vez que o dia escolhido cair\n// — hoje mesmo, se for hoje. Ao editar, a data ja combinada nao se mexe,\n// senao mudar o valor de um aluguel geraria a conta do mes de novo.\nif (!ehExistente) {\n  const hoje = hojeNoBrasil();\n  const [ano, mes] = hoje.split(\"-\").map(Number);\n  const nesteMes = diaNoMes(ano, mes - 1, diaDoMes);\n  fields.Proxima_Geracao = nesteMes >= hoje ? nesteMes : diaNoMes(ano, mes, diaDoMes);\n}\n\nreturn [{\n  json: {\n    invalido: false,\n    metodo: ehExistente ? \"PATCH\" : \"POST\",\n    url: \"https://api.airtable.com/v0/appjAmWXV7Zr33UqE/tblb8QplhcGRP6SZ7\",\n    corpo: { typecast: true, records: [ehExistente ? { id, fields } : { fields }] },\n  },\n}];"
      },
