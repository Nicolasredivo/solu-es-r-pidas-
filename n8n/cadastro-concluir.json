    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst entrada = $('Monta busca').first().json;\nconst registro = $input.all().map((i) => i.json).find((r) => r && r.id);\n\nconst falha = (motivo, extra) => [{ json: Object.assign({ valido: false, motivo, incrementar: false }, extra || {}) }];\n\nif (!registro) return falha('expirado');\nconst campos = registro.fields || {};\n\n// Só convite pendente (ainda sem senha). Conta já ativa troca a senha pela\n// recuperação de senha, nunca por aqui -- os dois fluxos usam os mesmos\n// campos de código, e é essa trava que impede um de usar o código do outro.\nif (campos.Senha_Hash) return falha('expirado');\n\nconst hashGuardado = campos.Codigo_Recuperacao_Hash || '';\nconst expiraEm = campos.Codigo_Expira_Em ? new Date(campos.Codigo_Expira_Em).getTime() : 0;\nconst tentativas = Number(campos.Codigo_Tentativas) || 0;\n\nif (!hashGuardado || !expiraEm || expiraEm < Date.now() || tentativas >= 5) {\n  return falha('expirado', { usuarioId: registro.id });\n}\n\nconst hashDigitado = crypto.createHash('sha256').update(entrada.codigo).digest('hex');\nconst a = Buffer.from(hashDigitado, 'hex');\nconst b = Buffer.from(hashGuardado, 'hex');\nconst bate = a.length === b.length && crypto.timingSafeEqual(a, b);\n\nif (!bate) {\n  return [{\n    json: {\n      valido: false,\n      motivo: tentativas + 1 >= 5 ? 'esgotado' : 'incorreto',\n      incrementar: true,\n      usuarioId: registro.id,\n      tentativasAtuais: tentativas,\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    valido: true,\n    usuarioId: registro.id,\n    nome: campos.Nome || '',\n    papel: campos.Papel || 'Usuario',\n    historico: campos.Historico || '',\n  },\n}];\n"
      },
