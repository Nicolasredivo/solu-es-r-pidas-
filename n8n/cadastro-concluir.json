      "parameters": {
        "jsCode": "const corpo = $input.first().json.body || {};\nconst cabecalhos = $input.first().json.headers || {};\n\nconst email = String(corpo.email || '').trim().toLowerCase();\nconst codigo = String(corpo.codigo || '').replace(/\\D/g, '').slice(0, 6);\nconst senha = String(corpo.senha || '');\nconst nome = String(corpo.nome || '').trim().replace(/\\s+/g, ' ').slice(0, 80);\nconst dispositivo = String(corpo.dispositivo || cabecalhos['user-agent'] || '').slice(0, 120);\n\n// Barra invertida antes, aspas depois: senão um e-mail terminado em \"\\\"\n// escaparia a aspa de fechamento da fórmula do Airtable.\nconst emailEscapado = email.replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\");\n\nreturn [{\n  json: {\n    email,\n    codigo,\n    senha,\n    nome,\n    dispositivo,\n    formula: \"LOWER({Email}) = '\" + emailEscapado + \"'\",\n  },\n}];\n"
      },
