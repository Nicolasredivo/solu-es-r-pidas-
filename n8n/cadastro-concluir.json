        "jsCode": "const BASE = 'app6PyYmtFduIMp7B';\nconst TABELA = 'tblucYjrD3SKf1azh';\n\nconst conf = $('Confere codigo').first().json;\nconst entrada = $('Monta busca').first().json;\nconst hash = $input.first().json.hash;\n\nconst carimbo = new Date()\n  .toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })\n  .replace(',', '');\nconst nivel = conf.papel === 'Dono' ? 'acesso total' : 'acesso padrão';\nconst linha = carimbo + ' — Conta ativada (' + nivel + ')';\n\nconst campos = {\n  Senha_Hash: hash,\n  Ativo: true,\n  Codigo_Recuperacao_Hash: '',\n  Codigo_Expira_Em: null,\n  Codigo_Tentativas: 0,\n  Historico: (conf.historico ? conf.historico + '\\n' : '') + linha,\n};\nif (!conf.nome) campos.Nome = entrada.nome;\n\nreturn [{\n  json: {\n    metodo: 'PATCH',\n    url: 'https://api.airtable.com/v0/' + BASE + '/' + TABELA + '/' + conf.usuarioId,\n    corpo: { fields: campos },\n  },\n}];\n"
