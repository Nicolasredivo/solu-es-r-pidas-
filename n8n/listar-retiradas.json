        "jsCode": "const achadas = $input.all().filter((i) => i.json && i.json.id && !i.json.error);\n\nconst retiradas = achadas.map((i) => {\n  const f = i.json.fields || {};\n  return {\n    id: i.json.id,\n    data: f.Data || \"\",\n    socio: f.Socio || \"\",\n    valor: f.Valor || 0,\n    observacoes: f.Observacoes || \"\",\n  };\n});\n\n// Mais recente primeiro; empate no mesmo dia fica com a ultima gravada.\nretiradas.reverse();\nretiradas.sort((a, b) => String(b.data).localeCompare(String(a.data)));\n\nreturn [{ json: { ok: true, retiradas } }];"
