    {
      "id": "17cd3840-05f8-47b6-959d-14bd967dae91",
      "name": "Guarda ref 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        180
      ],
      "parameters": {
        "jsCode": "// Junta a resposta do Asaas com a referência da chamada (para o banco saber de quem é).\nreturn [{ json: { ref: $('Uma por vez 1').first().json.ref, resposta: $input.first().json } }];"
      }
    },
    {
      "id": "be097771-1c7d-497e-95dd-119bda20a00a",
      "name": "Junta respostas 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        420
      ],
      "parameters": {
        "jsCode": "// Respostas da primeira volta; e quem pagou sem ser cliente conhecido (PIX direto): pede o nome e o documento.\nconst plano = $('Plano').first().json.r || {};\nconst respostas = $input.all().map((i) => i.json).filter((x) => x.ref && x.ref.tipo !== 'nada');\nconst conhecidos = new Set((plano.clientesConhecidos || []).map((k) => k.conta + '|' + k.asaas));\nconst falta = new Map();\nfor (const x of respostas) {\n  if (!x.ref || x.ref.tipo !== 'lista' || !x.resposta || !Array.isArray(x.resposta.data)) continue;\n  for (const pay of x.resposta.data) {\n    if (!['RECEIVED', 'CONFIRMED', 'RECEIVED_IN_CASH'].includes(pay.status) || !pay.customer) continue;\n    const k = x.ref.conta + '|' + pay.customer;\n    if (!conhecidos.has(k)) falta.set(k, { conta: x.ref.conta, id: pay.customer });\n  }\n}\nreturn [{ json: { respostas, falta: [...falta.values()].slice(0, 30) } }];"
      }
    },
    {
      "id": "156d5716-ca8b-47f1-84fe-c3788c89ae0a",
      "name": "Lista chamadas 2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        420
      ],
      "parameters": {
        "jsCode": "const f = $('Junta respostas 1').first().json.falta || [];\nconst c = f.map((k) => ({ json: { conta: k.conta, metodo: 'GET', url: 'https://api.asaas.com/v3/customers/' + encodeURIComponent(k.id), ref: { tipo: 'cliente', id: k.id } } }));\nreturn c.length ? c : [{ json: { pular: true, ref: { tipo: 'nada' } } }];"
      }
    },
    {
      "id": "1066365f-bffa-47a0-949b-ae4b65de2414",
      "name": "Uma por vez 2",
