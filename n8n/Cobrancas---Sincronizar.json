    {
      "id": "658d875a-340b-4c83-94a5-2ce277611277",
      "name": "Junta lembretes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        660
      ],
      "parameters": {
        "jsCode": "const enviados = $('Lista lembretes').all().filter((i) => !i.json.nada);\nconst res = $input.all();\nconst lembretes = enviados.map((i, k) => ({ evento: i.json.evento, quantos: i.json.quantos, ok: !!(res[k] && res[k].json && !res[k].json.error && !res[k].json.nada) }));\nreturn [{ json: { lembretes } }];"
      }
    },
