    {
      "id": "3e7f4985-2045-470c-935c-160c10d3c0bf",
      "name": "Lista lembretes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        660
      ],
      "parameters": {
        "jsCode": "// Lembrete de véspera (o Asaas não tem \"1 dia antes\"): um e-mail por boleto, para os e-mails do cliente.\nconst r = $('Plano').first().json.r || {};\nconst l = (r.lembretes || []).filter((x) => Array.isArray(x.emails) && x.emails.length);\nreturn l.length ? l.map((x) => ({ json: { evento: x.evento, para: x.emails.join(', '), quantos: x.emails.length, assunto: x.assunto, html: x.html } })) : [{ json: { nada: true } }];"
      }
    },
