    {
      "id": "5abbce98-9ee2-42db-8d42-7317610d37c2",
      "name": "Junta clientes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        540
      ],
      "parameters": {
        "jsCode": "const j = $('Junta respostas 1').first().json;\nconst clientes = $input.all().map((i) => i.json).filter((x) => x.ref && x.ref.tipo === 'cliente' && x.resposta && x.resposta.id)\n  .map((x) => ({ customer: { id: x.resposta.id, name: x.resposta.name, cpfCnpj: x.resposta.cpfCnpj } }));\nreturn [{ json: { p: { respostas: j.respostas, clientes } } }];"
      }
    },
