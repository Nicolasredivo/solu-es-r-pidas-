    {
      "parameters": {
        "jsCode": "// A tabela tem uma linha so. Se estiver vazia, devolve tudo zerado em vez de\n// quebrar: o painel sabe pedir para configurar.\nconst achado = $input.all().filter((i) => i.json && i.json.id && !i.json.error)[0];\nconst f = achado ? (achado.json.fields || {}) : {};\n\nreturn [{\n  json: {\n    ok: true,\n    config: {\n      id: achado ? achado.json.id : \"\",\n      saldoInicial: f.Saldo_Inicial || 0,\n      dataSaldoInicial: f.Data_Saldo_Inicial || \"\",\n      reservaMeta: f.Reserva_Meta || 0,\n      giroMeta: f.Giro_Meta || 0,\n      regime: f.Regime || \"MEI\",\n      impostoFixoMensal: f.Imposto_Fixo_Mensal || 0,\n      // O Airtable guarda porcentagem como fracao: 6% chega como 0.06.\n      aliquotaImposto: (f.Aliquota_Imposto || 0) * 100,\n      tetoAnual: f.Teto_Anual || 0,\n      folhaMensal: f.Folha_Mensal || 0,\n      provisionaDecimoFerias: Boolean(f.Provisiona_Decimo_Ferias),\n      socio1Nome: f.Socio_1_Nome || \"\",\n      socio2Nome: f.Socio_2_Nome || \"\",\n      // Fracao no Airtable, porcentagem no app: 1/3 vira 33,3333.\n      socio1Percentual: (f.Socio_1_Percentual || 0) * 100,\n      socio2Percentual: (f.Socio_2_Percentual || 0) * 100,\n    },\n  },\n}];"
      },
